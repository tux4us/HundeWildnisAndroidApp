<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark Theme -->
    <style name="Base.Theme.HundeWildnis" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Globale Widget Styles -->
        <item name="materialButtonStyle">@style/Widget.App.Button</item>

        <item name="colorPrimary">#2d5016</item>
        <item name="colorPrimaryVariant">#1a3009</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#6b8e4e</item>
        <item name="colorSecondaryVariant">#4a6135</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>

        <!-- Menü-Farben -->
        <item name="actionMenuTextColor">#FFFFFF</item>
        <item name="actionOverflowButtonStyle">@style/Widget.App.Overflow</item>

        <!-- Hintergrundfarben für Dark Mode -->
        <item name="android:windowBackground">#1a1a1a</item>
        <item name="android:colorBackground">#1a1a1a</item>

        <!-- Material Button für AlertDialog -->
        <item name="materialAlertDialogTheme">@style/AlertDialogTheme.Dark</item>
        <item name="alertDialogTheme">@style/AlertDialogTheme.Dark</item>
    </style>

    <style name="Theme.HundeWildnis" parent="Base.Theme.HundeWildnis" />

    <!-- AlertDialog Theme für Dark Mode - KOMPLETT NEU -->
    <style name="AlertDialogTheme.Dark" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <!-- Dialog Hintergrund -->
        <item name="colorSurface">#2a2a2a</item>
        <item name="colorOnSurface">#FFFFFF</item>

        <!-- Text Farben - ALLE auf WEISS -->
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#CCCCCC</item>
        <item name="colorOnSurfaceVariant">#FFFFFF</item>

        <!-- Button Farben - WICHTIG! -->
        <item name="colorPrimary">#FFFFFF</item>
        <item name="colorSecondary">#FFFFFF</item>
        <item name="colorTertiary">#FFFFFF</item>

        <!-- Button Bar Styles -->
        <item name="buttonBarPositiveButtonStyle">@style/Widget.HundeWildnis.Button.TextButton.Dialog.Dark</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.HundeWildnis.Button.TextButton.Dialog.Dark</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.HundeWildnis.Button.TextButton.Dialog.Dark</item>

        <!-- Button Bar Style -->
        <item name="buttonBarStyle">@style/Widget.App.ButtonBar</item>

        <!-- FORCE BUTTON STYLE FOR APPCOMPAT DIALOGS -->
        <item name="android:buttonStyle">@style/Widget.HundeWildnis.Button.TextButton.Dialog.Dark</item>
    </style>

    <!-- Dialog Button Style - ULTRA EXPLICIT -->
    <style name="Widget.HundeWildnis.Button.TextButton.Dialog.Dark" parent="Widget.Material3.Button.TextButton.Dialog">
        <!-- Text Farbe: WEISS - ALLE Varianten -->
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#FFFFFF</item>

        <!-- KORREKTUR: Platzprobleme bei großen Schriften -->
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:maxLines">2</item>
        <item name="android:singleLine">false</item>
        <item name="android:ellipsize">none</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">10sp</item>
        <item name="autoSizeMaxTextSize">16sp</item>

        <!-- Reduziere Insets und Padding radikal, um Platz zu sparen -->
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>

        <!-- Tint Farbe: WEISS -->
        <item name="iconTint">#FFFFFF</item>

        <!-- Hintergrund: TRANSPARENT -->
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:background">@android:color/transparent</item>

        <!-- Ripple: Leicht weiß -->
        <item name="rippleColor">#33FFFFFF</item>

        <!-- Material3 spezifisch -->
        <item name="materialThemeOverlay">@style/ThemeOverlay.HundeWildnis.Button.Dark</item>
    </style>

    <!-- Material Theme Overlay für Buttons -->
    <style name="ThemeOverlay.HundeWildnis.Button.Dark" parent="">
        <item name="colorPrimary">#FFFFFF</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorContainer">#FFFFFF</item>
        <item name="colorOnContainer">#000000</item>
    </style>

</resources>
