<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ═══════════════════════════════════════════════════════════
         Dark-Varianten der modus-automatischen Alias-Farben.
         Alle rd_group*_chip/accent- und rd_bg/rd_card/rd_border/rd_text-Farben
         werden NICHT hier gespiegelt, da sie in Kotlin-Code (StartGroupColors,
         StartTileAdapter) bereits explizit per isDark-Check zwischen den
         "_dark"/"_light"-Suffix-Varianten unterscheiden.
         Dieser Ordner dient ausschließlich für Farben, die direkt in XML
         (z.B. android:background) OHNE Suffix referenziert werden.
         ═══════════════════════════════════════════════════════════ -->

    <color name="rd_danger_toolbar">#8A2E22</color>

    <!-- rd_border_dark wird hier EXPLIZIT gesetzt (nicht nur in values/),
         da text_input_stroke_color.xml (color-night/) diese Ressource direkt
         in XML referenziert. Ohne diese Definition hier würde bei einem
         Dark-Mode-Gerät je nach Ressourcenauflösung ggf. ein falscher/alter
         Wert greifen. -->
    <color name="rd_border_dark">#6B6B6B</color>

    <color name="rd_overlay_accent">#C9A26A</color>
    <color name="rd_label_overlay">#CCC9A26A</color>
    <color name="rd_label_overlay_strong">#DDC9A26A</color>
    <color name="rd_ripple_accent">#33C9A26A</color>

    <color name="rd_surface_alt">#2B2B2B</color>

    <color name="rd_map_overlay">#DD1E1E1E</color>
</resources>