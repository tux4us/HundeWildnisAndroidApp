<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Light Theme -->
    <style name="Base.Theme.HundeWildnis" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">#2d5016</item>
        <item name="colorPrimaryVariant">#1a3009</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#6b8e4e</item>
        <item name="colorSecondaryVariant">#4a6135</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>

        <!-- AlertDialog Button Farben (WICHTIG!) -->
        <item name="colorAccent">#2d5016</item>
        <item name="android:textColorPrimary">#000000</item>

        <!-- Material Button für AlertDialog -->
        <item name="materialAlertDialogTheme">@style/AlertDialogTheme</item>

        <!-- Menü-Farben -->
        <item name="actionMenuTextColor">#FFFFFF</item>

        <!-- Hintergrundfarben für Light Mode -->
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:colorBackground">#FFFFFF</item>
    </style>

    <style name="Theme.HundeWildnis" parent="Base.Theme.HundeWildnis" />

    <!-- AlertDialog spezielles Theme für Light Mode -->
    <style name="AlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <!-- Dialog Hintergrund -->
        <item name="colorSurface">#FFFFFF</item>

        <!-- Text Farben -->
        <item name="colorOnSurface">#000000</item>
        <item name="android:textColorPrimary">#000000</item>

        <!-- Button Styles -->
        <item name="buttonBarPositiveButtonStyle">@style/DialogButtonStyle.Light</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButtonStyle.Light</item>
        <item name="buttonBarNeutralButtonStyle">@style/DialogButtonStyle.Light</item>
    </style>

    <!-- Einheitlicher Button Style für Light Mode Dialoge -->
    <style name="DialogButtonStyle.Light" parent="Widget.Material3.Button.TextButton.Dialog">
        <!-- Text Farbe: GRÜN -->
        <item name="android:textColor">#2d5016</item>

        <!-- Hintergrund: TRANSPARENT -->
        <item name="backgroundTint">@android:color/transparent</item>

        <!-- Ripple Effekt: Leicht grün -->
        <item name="rippleColor">#332d5016</item>
    </style>

</resources>
