<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Light Theme -->
    <style name="Base.Theme.HundeWildnis" parent="Theme.Material3.Light.NoActionBar">
        <!-- Globale Widget Styles -->
        <item name="materialButtonStyle">@style/Widget.App.Button</item>

        <item name="colorPrimary">@color/rd_bg_light</item>
        <item name="colorOnPrimary">@color/rd_text_primary_light</item>
        <item name="colorSecondary">@color/rd_group2_accent_light</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:statusBarColor">@color/rd_bg_light</item>
        <item name="android:navigationBarColor">@color/rd_bg_light</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>

        <!-- AlertDialog Button Farben (WICHTIG!) -->
        <item name="colorAccent">@color/rd_group2_accent_light</item>
        <item name="android:textColorPrimary">#000000</item>

        <!-- Material Button für AlertDialog -->
        <item name="materialAlertDialogTheme">@style/AlertDialogTheme</item>
        <item name="alertDialogTheme">@style/AlertDialogTheme</item>

        <!-- Menü-Farben -->
        <item name="actionMenuTextColor">@color/rd_text_primary_light</item>
        <item name="actionOverflowButtonStyle">@style/Widget.App.Overflow</item>

        <!-- Hintergrundfarben für Light Mode -->
        <item name="android:windowBackground">@color/rd_bg_light</item>
        <item name="android:colorBackground">@color/rd_bg_light</item>
    </style>

    <style name="Theme.HundeWildnis" parent="Base.Theme.HundeWildnis" />

    <style name="Widget.App.Overflow" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="android:src">@drawable/ic_menu_hamburger</item>
    </style>

    <!-- AlertDialog spezielles Theme für Light Mode -->
    <style name="AlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <!-- Dialog Hintergrund -->
        <item name="colorSurface">#FFFFFF</item>

        <!-- Text Farben -->
        <item name="colorOnSurface">#000000</item>
        <item name="android:textColorPrimary">#000000</item>

        <!-- Button Styles -->
        <item name="buttonBarPositiveButtonStyle">@style/DialogButtonStyle.Light</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButtonStyle.Light</item>
        <item name="buttonBarNeutralButtonStyle">@style/DialogButtonStyle.Light</item>

        <!-- Button Bar Style -->
        <item name="buttonBarStyle">@style/Widget.App.ButtonBar</item>

        <!-- FORCE BUTTON STYLE FOR APPCOMPAT DIALOGS -->
        <item name="android:buttonStyle">@style/DialogButtonStyle.Light</item>
    </style>

    <style name="Widget.App.ButtonBar" parent="Widget.AppCompat.ButtonBar.AlertDialog">
        <item name="android:padding">0dp</item>
    </style>

    <!-- Einheitlicher Button Style für Light Mode Dialoge -->
    <style name="DialogButtonStyle.Light" parent="Widget.Material3.Button.TextButton.Dialog">
        <!-- Text Farbe: SEKUNDÄRAKZENT -->
        <item name="android:textColor">?attr/colorSecondary</item>

        <!-- KORREKTUR: Platzprobleme bei großen Schriften -->
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:maxLines">2</item>
        <item name="android:singleLine">false</item>
        <item name="android:ellipsize">none</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">10sp</item>
        <item name="autoSizeMaxTextSize">16sp</item>

        <!-- Reduziere Insets und Padding radikal, um Platz zu sparen -->
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>

        <!-- Hintergrund: TRANSPARENT -->
        <item name="backgroundTint">@android:color/transparent</item>

        <!-- Ripple Effekt: Leicht grün -->
        <item name="rippleColor">#332d5016</item>
    </style>

</resources>
