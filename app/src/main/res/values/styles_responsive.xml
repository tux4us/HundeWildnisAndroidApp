<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- res/values/styles_responsive.xml -->
    <!-- DIESE STYLES SORGEN FÜR EINE BESSERE SKALIERUNG BEI INDIVIDUELLEN SCHRIFTGRÖSSEN -->

    <!-- Custom Button mit Auto-Scaling -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">12sp</item>
        <item name="autoSizeMaxTextSize">@dimen/text_button_large</item>
        <item name="autoSizeStepGranularity">1sp</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:minHeight">60dp</item>
    </style>

    <!-- Outlined-Button-Variante: eigene Textfarbe nötig, da colorPrimary
         app-weit auf die Hintergrundfarbe (rd_bg_light/rd_bg_dark) gemappt ist,
         nicht auf eine Akzentfarbe. Material3s OutlinedButton-Default würde sonst
         den Text in colorPrimary einfärben - im Dark-Modus praktisch unsichtbar
         (fast schwarzer Text auf dunklem Grund). -->
    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="strokeColor">?attr/colorOnBackground</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- TextInputLayout (OutlinedBox): eigener boxStrokeColor nötig, da Material3s
         Default den Rahmen über colorPrimary einfärbt - bei uns die Hintergrundfarbe,
         nicht ein Akzent. Ohne diesen Fix "verschwindet" der Rahmen beim Fokussieren/
         Tippen, weil er in der Hintergrundfarbe gezeichnet wird (fast unsichtbar). -->
    <style name="Widget.App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/text_input_stroke_color</item>
        <item name="hintTextColor">@color/rd_overlay_accent</item>
        <item name="android:textColorHint">?attr/colorOnSurface</item>
        <!-- Cursor-Farbe: app:cursorColor ist das korrekte Material-Components-
             Attribut (API 28+), NICHT android:cursorColor (existiert nicht im
             öffentlichen SDK). Auf niedrigeren API-Leveln greift automatisch
             ?attr/colorControlActivated als Fallback. -->
        <item name="cursorColor">@color/rd_overlay_accent</item>
    </style>

    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- TEXT APPEARANCE STYLES (Punkt-Notation für Vererbung) -->
    <!-- ════════════════════════════════════════════════════════════════ -->

    <style name="TextAppearance.App" parent="TextAppearance.Material3.BodyMedium" />
    <style name="TextAppearance.App.Headline" parent="TextAppearance.App" />
    <style name="TextAppearance.App.Body" parent="TextAppearance.App" />

    <style name="TextAppearance.App.Headline.Large">
        <item name="android:textSize">@dimen/text_headline_large</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="TextAppearance.App.Headline.Medium">
        <item name="android:textSize">@dimen/text_headline_medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="TextAppearance.App.Body.Large">
        <item name="android:textSize">@dimen/text_body_large</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="TextAppearance.App.Body.Medium">
        <item name="android:textSize">@dimen/text_body_medium</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="TextAppearance.App.Label">
        <item name="android:textSize">@dimen/text_label_medium</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <!-- Button Style ohne Auto-Scaling für kleine/spezielle Buttons -->
    <style name="Widget.App.Button.Fixed" parent="Widget.Material3.Button">
        <item name="autoSizeTextType">none</item>
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">88dp</item>
    </style>

    <!-- Bottom Navigation Styling -->
    <style name="Widget.App.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#4DA3762F</item> <!-- 30% transparenter Ocker-Akzent -->
        <item name="marginHorizontal">12dp</item>
    </style>

    <style name="TextAppearance.App.BottomNav.Active" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="TextAppearance.App.BottomNav.Inactive" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">#E6FFFFFF</item>
    </style>
</resources>