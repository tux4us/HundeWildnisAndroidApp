<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ═══════════════════════════════════════════════════════════
         REDESIGN 2026 — Glas-Design, ausschließlich Dark.
         Gruppenfarben (rd_group1..6_accent / _chip / _stroke) und alle Glas-
         Tokens (gl_*) stehen in colors_glass.xml.
         ═══════════════════════════════════════════════════════════ -->

    <!-- Grundflächen. rd_card ist bewusst opak: Popup-Menüs, Spinner-Listen und
         Auswahlfenster dürfen nicht durchscheinen. -->
    <color name="rd_bg">#0D0E10</color>
    <color name="rd_card">#1C2024</color>
    <color name="rd_border">#6B6B6B</color>
    <color name="rd_text_primary">#F0F0EE</color>
    <color name="rd_text_secondary">#B2B2AE</color>

    <!-- Notfall: neutrales Glas mit kräftigem roten Rand -->
    <color name="rd_danger_chip">#9914181F</color>
    <color name="rd_danger_stroke">#F2F0786C</color>
    <color name="rd_danger_text">#FFE0D8</color>
    <color name="rd_danger_toolbar">#B8161A1E</color>

    <!-- Blog-Vorschau — waldiges Grün (Glas) -->
    <color name="rd_blog_header">#9914181F</color>

    <!-- Akzent-Aliase für direkte XML-Verwendung -->
    <color name="rd_overlay_accent">#C9A26A</color>
    <color name="rd_label_overlay">#CCC9A26A</color>
    <color name="rd_label_overlay_strong">#DDC9A26A</color>
    <color name="rd_ripple_accent">#33C9A26A</color>

    <!-- Abgesetzte innere Fläche innerhalb einer Karte (Header-Leisten, Divider-Container) -->
    <color name="rd_surface_alt">#14FFFFFF</color>

    <!-- Overlay für auf Kartenansichten schwebende Buttons/Controls (höhere Deckkraft wegen Kartenhintergrund) -->
    <color name="rd_map_overlay">#D91A2025</color>
</resources>
