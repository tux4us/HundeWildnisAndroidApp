<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ✅ Öffentliche Ordner (für Teilen von Exporten) -->
    <external-path
        name="external_root"
        path="." />

    <external-path
        name="download_dir"
        path="Download/" />

    <external-path
        name="documents_dir"
        path="Documents/" />

    <!-- App-spezifischer Speicher -->
    <external-files-path
        name="external_files"
        path="." />

    <!-- Interner Speicher (wiederhergestellte Fotos) -->
    <files-path
        name="restored_photos"
        path="restored_photos/" />

    <!-- ✅ Cache für PDFs (Communication, WalkingSpeed, DailyNotes) -->
    <cache-path
        name="cache"
        path="." />

    <cache-path
        name="pdf_cache"
        path="." />

</paths>