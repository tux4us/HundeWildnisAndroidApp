<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ✅ Für Kamera-Fotos (Android 9 und älter) -->
    <external-path
        name="external_pictures"
        path="Pictures/HundeWildnis/" />

    <!-- ✅ Für PDFs (Android 9 und älter) -->
    <external-path
        name="external_documents"
        path="Documents/HundeWildnis/" />

    <!-- Für Cache (Teilen) -->
    <cache-path
        name="shared_pdfs"
        path="." />

    <!-- Legacy (falls noch verwendet) -->
    <external-files-path
        name="pictures"
        path="Pictures/" />
    <external-files-path
        name="documents"
        path="Documents/" />

    <!-- ✅ NEU: Backup-Dateien --><external-files-path
    name="backups"
    path="Documents/HundeWildnis_Backups/" />
    <!-- ✅ NEU: Wiederhergestellte Fotos -->
    <files-path
        name="restored_photos"
        path="photos/" />

</paths>
