<?xml version="1.0" encoding="utf-8"?>
<!--
   Regeln für die Android-Datensicherung (Android 11 und älter).
   Verschlüsselte Zugangsdaten (API-Schlüssel, WebDAV-Zugang) werden nicht gesichert:
   Ihr Schlüsselmaterial liegt im Android-Keystore des Geräts und lässt sich nach einer
   Wiederherstellung nicht lesen.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="secure_app_settings.xml" />
    <exclude domain="sharedpref" path="webdav_credentials.xml" />
    <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
</full-backup-content>
