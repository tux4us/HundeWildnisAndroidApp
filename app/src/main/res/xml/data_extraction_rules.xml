<?xml version="1.0" encoding="utf-8"?>
<!--
   Regeln für Cloud-Sicherung und Geräteübertragung (Android 12 und neuer).
   Verschlüsselte Zugangsdaten (API-Schlüssel, WebDAV-Zugang) werden nicht übertragen:
   Ihr Schlüsselmaterial liegt im Android-Keystore des Geräts und lässt sich auf einem anderen
   Gerät bzw. nach einer Wiederherstellung nicht lesen.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_app_settings.xml" />
        <exclude domain="sharedpref" path="webdav_credentials.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_app_settings.xml" />
        <exclude domain="sharedpref" path="webdav_credentials.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
    </device-transfer>
</data-extraction-rules>
