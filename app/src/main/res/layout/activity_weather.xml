<?xml version="1.0" encoding="utf-8"?>
<!-- ERWEITERT: Mit Pfotenwetter-Index, Temperatur-Chart, Tageslänge -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    android:background="#1a1a1a">

    <com.google.android.material.appbar.AppBarLayout android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#2d5016"
            app:titleTextColor="#FFFFFF"
            app:navigationIcon="?attr/homeAsUpIndicator" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Wetter Icon -->
            <TextView
                android:id="@+id/weatherIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:text="☀️"
                android:textSize="72sp" />

            <!-- Temperatur -->
            <TextView
                android:id="@+id/temperatureText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:text="--°C"
                android:textColor="#8fad6f"
                android:textSize="48sp"
                android:textStyle="bold" />

            <!-- Wetterbeschreibung -->
            <TextView
                android:id="@+id/descriptionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:text="Lade Wetterdaten..."
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <!-- Wetterwarnung-Badge -->
            <TextView
                android:id="@+id/warningBadgeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"
                android:background="@drawable/good_badge_bg"
                android:padding="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="✅ Keine Wetterwarnung"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="visible" />

            <!-- ════════════════════════════════════════════════════════════════ -->
            <!-- NEU 1: TRAININGSWETTER-INDEX CARD -->
            <!-- ════════════════════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/pawWeatherCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#2d2d2d"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🐾 Trainingswetter-Index"
                        android:textColor="#8fad6f"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <!-- Warnungen -->
                    <TextView
                        android:id="@+id/pawWeatherIndexText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Wird berechnet..."
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.3"
                        android:layout_marginBottom="12dp" />

                    <!-- HINWEISE -->
                    <TextView
                        android:id="@+id/groomingTipsText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#FFC107"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.3"
                        android:visibility="gone"
                        android:layout_marginBottom="8dp" />

                    <!-- Beste TRAININGS-Zeiten -->
                    <TextView
                        android:id="@+id/walkingTimesText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#64B5F6"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.3"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ════════════════════════════════════════════════════════════════ -->
            <!-- NEU 2: TAGESLÄNGE & DÄMMERUNG CARD -->
            <!-- ════════════════════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/daylightCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#2d2d2d"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌅 Tageslicht und Dämmerung"
                        android:textColor="#8fad6f"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <!-- Tageslänge -->
                    <TextView
                        android:id="@+id/daylightDurationText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="☀️ Tageslänge: --h --m"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <!-- Trend -->
                    <TextView
                        android:id="@+id/daylightTrendText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#64B5F6"
                        android:textSize="13sp"
                        android:visibility="gone"
                        android:layout_marginBottom="12dp" />

                    <!-- Morgendämmerung -->
                    <TextView
                        android:id="@+id/dawnText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🌄 Morgendämmerung: --:--"
                        android:textColor="#C8C8C8"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp" />

                    <!-- Sonnenaufgang (schon vorhanden) -->
                    <TextView
                        android:id="@+id/sunriseText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🌅 Sonnenaufgang: --:--"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp" />

                    <!-- Sonnenuntergang (schon vorhanden) -->
                    <TextView
                        android:id="@+id/sunsetText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🌇 Sonnenuntergang: --:--"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp" />

                    <!-- Abenddämmerung -->
                    <TextView
                        android:id="@+id/duskText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🌆 Abenddämmerung: --:--"
                        android:textColor="#CECDCD"
                        android:textSize="14sp"
                        android:layout_marginBottom="12dp" />

                    <!-- Licht-Empfehlung -->
                    <TextView
                        android:id="@+id/lightRecommendationText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#FFF18C"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.3"
                        android:visibility="gone"
                        android:layout_marginBottom="8dp" />

                    <!-- Goldene Stunde -->
                    <TextView
                        android:id="@+id/goldenHourText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#FFCA80"
                        android:textSize="12sp"
                        android:lineSpacingMultiplier="1.3"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/moonPhaseCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1e2233"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Titel -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌙 Mondphase"
                        android:textColor="#C8A8E8"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <!-- Großes Mond-Emoji + Phasenname nebeneinander -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <com.hundewildnis.app.MoonPhaseView
                            android:id="@+id/moonPhaseView"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:layout_marginEnd="20dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/moonPhaseNameText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Vollmond"
                                android:textColor="#E8D5FF"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:id="@+id/moonAgeText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mondalter: -- von 29,5 Tagen"
                                android:textColor="#E5E5EF"
                                android:textSize="12sp"
                                android:layout_marginBottom="6dp" />

                            <TextView
                                android:id="@+id/moonIlluminationText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Beleuchtung: --%"
                                android:textColor="#C8A8E8"
                                android:textSize="13sp"
                                android:layout_marginBottom="6dp" />

                            <!-- Beleuchtungs-Fortschrittsbalken -->
                            <ProgressBar
                                android:id="@+id/moonIlluminationBar"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="6dp"
                                android:max="100"
                                android:progress="100"
                                android:progressTint="#C8A8E8"
                                android:progressBackgroundTint="#333355" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#333355"
                        android:layout_marginBottom="12dp" />

                    <!-- Nächste Mondphasen -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:id="@+id/moonNextFullText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🌕 Vollmond: in -- Tagen"
                            android:textColor="#D7D1CC"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/moonNextNewText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🌑 Neumond: in -- Tagen"
                            android:textColor="#C8C8D9"
                            android:textSize="13sp"
                            android:gravity="end" />
                    </LinearLayout>

                    <!-- Mondzeichen -->
                    <TextView
                        android:id="@+id/moonZodiacText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🔯 Mondzeichen: --"
                        android:textColor="#F0F0F8"
                        android:textSize="12sp"
                        android:lineSpacingMultiplier="1.3"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#333355"
                        android:layout_marginBottom="12dp" />

                    <!-- Astronomische Information -->
                    <TextView
                        android:id="@+id/moonAstronomyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🔭 Astronomie: wird geladen..."
                        android:textColor="#C8C8DD"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.4"
                        android:layout_marginBottom="12dp" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#333355"
                        android:layout_marginBottom="12dp" />

                    <!-- Natur & Tierwelt -->
                    <TextView
                        android:id="@+id/moonNatureText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🌿 Natur &amp; Tierwelt: wird geladen..."
                        android:textColor="#A8CCA8"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.4"
                        android:layout_marginBottom="12dp" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#333355"
                        android:layout_marginBottom="12dp" />

                    <!-- Hund & Training -->
                    <TextView
                        android:id="@+id/moonDogTipsText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🐕 Hund &amp; Training: wird geladen..."
                        android:textColor="#F0C87A"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.4" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <!-- Min/Max Temperatur -->
            <TextView
                android:id="@+id/dailyMinMaxText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Minimal: --°C • Maximal: --°C"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginBottom="24dp" />

            <!-- ════════════════════════════════════════════════════════════════ -->
            <!-- NEU 3: TEMPERATUR-VERLAUFSGRAFIK -->
            <!-- ════════════════════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#2d2d2d"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📊 24h-Temperaturverlauf"
                        android:textColor="#8fad6f"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:padding="16dp"
                        android:paddingBottom="8dp" />

                    <!-- Custom Temperature Chart View -->
                    <com.hundewildnis.app.TemperatureChartView
                        android:id="@+id/temperatureChart"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Aktuelles Wetter Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#2d2d2d"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aktuelles Wetter"
                        android:textColor="#8fad6f"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <!-- Gefühlte Temperatur mit Windchill -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Gefühlt"
                            android:textColor="#999999"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/feelsLikeText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--°C"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Luftfeuchtigkeit -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Luftfeuchtigkeit"
                            android:textColor="#999999"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/humidityText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--%"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Windstärke (Beaufort Text) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Windstärke"
                            android:textColor="#999999"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/windStrengthText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Wind -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Wind und Richtung"
                            android:textColor="#999999"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/windText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-- km/h"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:gravity="end" />
                    </LinearLayout>

                    <!-- Niederschlag -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Niederschlag"
                            android:textColor="#999999"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/precipitationText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-- mm"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Weitere Details Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#2d2d2d"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Weitere Details"
                        android:textColor="#8fad6f"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <!-- Luftdruck -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Luftdruck"
                            android:textColor="#999999"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/pressureText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-- hPa"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Sichtweite -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Sichtweite"
                            android:textColor="#999999"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/visibilityText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="> 10 km"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- UV-Index -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="UV-Index"
                            android:textColor="#999999"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/uvIndexText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 24h Vorhersage Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#2d2d2d"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24h-Vorhersage (stündlich)"
                        android:textColor="#8fad6f"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:padding="16dp"
                        android:paddingBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tippe👆🏼 für Details. Verschiebe 👉🏼 für weitere Stunden"
                        android:textColor="#E9E375"
                        android:textSize="12sp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="8dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/forecastRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- NEU: Niederschlags-Diagramm Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#2d2d2d"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌧️ 24h-Niederschlagsmenge"
                        android:textColor="#2196F3"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:padding="16dp"
                        android:paddingBottom="8dp" />

                    <!-- Custom Precipitation Chart View -->
                    <com.hundewildnis.app.PrecipitationChartView
                        android:id="@+id/precipitationChart"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Regenradar Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#2d2d2d"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2h Niederschlagsradar"
                        android:textColor="#8fad6f"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:padding="16dp"
                        android:paddingBottom="8dp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="360dp">

                        <WebView
                            android:id="@+id/radarWebView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📡 = Aktuelle Daten"
                        android:textColor="#666666"
                        android:textSize="12sp"
                        android:padding="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Standort Info -->
            <TextView
                android:id="@+id/locationText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="📍 Standort wird ermittelt..."
                android:textColor="#FAFAFA"
                android:textSize="16sp" />

            <!-- Datenquelle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="Daten: © Open-Meteo (CC BY 4.0)"
                android:textColor="#666666"
                android:textSize="11sp"
                android:autoLink="web"
                android:linksClickable="true" />

        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="#8fad6f"
        android:visibility="visible" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
