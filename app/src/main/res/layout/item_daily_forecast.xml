<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="110dp"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        android:gravity="center">

        <!-- Wochentag -->
        <TextView
            android:id="@+id/dailyDayText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mo"
            android:textColor="@color/rd_overlay_accent"
            android:textSize="@dimen/text_body_medium"
            android:textStyle="bold"
            android:layout_marginBottom="2dp" />

        <!-- Datum -->
        <TextView
            android:id="@+id/dailyDateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="16.06."
            android:textColor="#999999"
            android:textSize="@dimen/text_body_small"
            android:layout_marginBottom="6dp" />

        <!-- Wetter-Icon -->
        <TextView
            android:id="@+id/dailyIconText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☀️"
            android:textSize="22sp"
            android:layout_marginBottom="6dp" />

        <!-- Max-Temperatur -->
        <TextView
            android:id="@+id/dailyMaxTempText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="24°"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_body_medium"
            android:textStyle="bold"
            android:layout_marginBottom="2dp" />

        <!-- Min-Temperatur -->
        <TextView
            android:id="@+id/dailyMinTempText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14°"
            android:textColor="#AAAAAA"
            android:textSize="@dimen/text_body_small"
            android:layout_marginBottom="6dp" />

        <!-- Regenwahrscheinlichkeit -->
        <TextView
            android:id="@+id/dailyRainText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💧 20%"
            android:textColor="#7faacc"
            android:textSize="@dimen/text_body_small"
            android:layout_marginBottom="2dp" />

        <!-- Wind (Beaufort) -->
        <TextView
            android:id="@+id/dailyWindText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💨 Bft 2"
            android:textColor="#999999"
            android:textSize="@dimen/text_body_small" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
