<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false">

    <com.google.android.material.appbar.AppBarLayout android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="false">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:titleTextColor="?attr/colorOnPrimary" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔄 WebDAV-Synchronisation"
                android:textSize="@dimen/text_body_medium"
                android:textStyle="bold"
                android:textAlignment="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Synchronisiert deine HundeWildnis-Daten zwischen mehreren Geräten über einen eigenen WebDAV-Server (z.B. Nextcloud, Hetzner Storage Box, Mailbox.org)."
                android:textSize="@dimen/text_body_medium"
                android:textAlignment="center"
                android:textColor="#666666"
                android:layout_marginBottom="24dp" />

            <!-- Sync aktivieren -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchWebdavEnabled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sync aktivieren"
                        android:textStyle="bold" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Zugangsdaten + Auto-Sync + Manueller Sync (sichtbar wenn aktiviert) -->
            <LinearLayout
                android:id="@+id/layoutWebdavCredentials"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Zugangsdaten -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Zugangsdaten"
                            android:textSize="@dimen/text_body_medium"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Server-URL"
                            android:layout_marginBottom="4dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etServerUrl"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textUri" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="z.B. https://cloud.example.com/remote.php/dav/files/benutzername/"
                            android:textSize="12sp"
                            android:textColor="#999999"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="📍 So findest du die WebDAV-Adresse bei Nextcloud:\n1. Dateien-App öffnen\n2. Unten links auf das Zahnrad-Symbol tippen\n3. Bereich „WebDAV“ → Adresse kopieren\n\n⚠️ Wichtig: Die allgemein angezeigte Server-Adresse reicht NICHT aus - es muss der vollständige WebDAV-Pfad inkl. /remote.php/dav/files/BENUTZERNAME/ sein, sonst schlägt die Synchronisation mit „HTTP 403“ fehl.\n\nBei anderen Anbietern (z.B. Mailbox.org, Hetzner) kann der Pfad abweichen - dort hilft meist die Hilfeseite des jeweiligen Anbieters zum Stichwort „WebDAV-Adresse“."
                            android:textSize="12sp"
                            android:textColor="#1976D2"
                            android:layout_marginBottom="12dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Benutzername"
                            android:layout_marginBottom="8dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etUsername"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Passwort / App-Passwort"
                            app:endIconMode="password_toggle"
                            android:layout_marginBottom="8dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPassword"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPassword" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/tvPasswordSavedHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🔒 Es ist bereits ein Passwort hinterlegt. Leer lassen, um es weiter zu verwenden. Nur ausfüllen, wenn du ein in Nextcloud (oder bei deinem Anbieter) bereits erzeugtes App-Passwort hinterlegen möchtest - hier wird kein neues Passwort erstellt."
                            android:textSize="12sp"
                            android:textColor="#2E7D32"
                            android:layout_marginBottom="4dp"
                            android:visibility="gone" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tipp: Verwende ein App-Passwort (z.B. Nextcloud → Einstellungen → Sicherheit), nicht dein Hauptpasswort."
                            android:textSize="12sp"
                            android:textColor="#999999"
                            android:layout_marginBottom="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTestConnection"
                            style="@style/Widget.App.Button.Outlined"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Verbindung testen" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClearWebdavCredentials"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:text="Zugangsdaten löschen"
                            android:textColor="#D32F2F"
                            app:icon="@android:drawable/ic_menu_delete"
                            app:iconTint="#D32F2F" />

                        <TextView
                            android:id="@+id/tvConnectionStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textSize="@dimen/text_body_medium"
                            android:visibility="gone" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Automatischer Sync -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Automatischer Sync"
                            android:textSize="@dimen/text_body_medium"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchAutoSync"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Im Hintergrund synchronisieren"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:id="@+id/layoutAutoSyncOptions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="8dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Intervall:" />

                                <Spinner
                                    android:id="@+id/spinnerSyncInterval"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />

                            </LinearLayout>

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switchWifiOnly"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Nur über WLAN synchronisieren" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Empfohlen: Verhindert hohen mobilen Datenverbrauch durch automatische Hintergrund-Synchronisation."
                                android:textSize="12sp"
                                android:textColor="#999999"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Manueller Sync -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Manueller Sync"
                            android:textSize="@dimen/text_body_medium"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSyncNow"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🔄 Jetzt synchronisieren"
                            app:cornerRadius="12dp"
                            android:layout_marginBottom="12dp" />

                        <ProgressBar
                            android:id="@+id/progressBar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:visibility="gone"
                            android:indeterminateTint="@color/rd_overlay_accent"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tvLastSync"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Letzter Sync: noch nie"
                            android:textSize="@dimen/text_body_medium"
                            android:textColor="#666666" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Info -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#E3F2FD"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💡 TIPP"
                            android:textSize="@dimen/text_body_medium"
                            android:textStyle="bold"
                            android:textColor="#1976D2"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Jedes Gerät legt eine eigene Backup-Datei im Ordner /HundeWildnis/ auf dem Server ab. Beim Sync werden alle Geräte zusammengeführt - es gehen keine Daten verloren."
                            android:textSize="@dimen/text_body_medium"
                            android:textColor="#1565C0"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tvDeviceId"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Geräte-ID: -"
                            android:textSize="12sp"
                            android:textColor="#1976D2" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
            <!-- Ende layoutWebdavCredentials -->

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>