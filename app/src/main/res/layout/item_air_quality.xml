<?xml version="1.0" encoding="utf-8"?>
<com.hundewildnis.app.GlassCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="90dp"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:gravity="center">

        <!-- Uhrzeit -->
        <TextView
            android:id="@+id/aqiTimeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:00"
            android:textColor="@color/rd_overlay_accent"
            android:textSize="@dimen/text_body_small"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <!-- AQI-Level (0–5) -->
        <TextView
            android:id="@+id/aqiValueText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            android:textColor="@color/gl_success"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="2dp" />

        <!-- Bezeichnung -->
        <TextView
            android:id="@+id/aqiLabelText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gut"
            android:textColor="@color/gl_success"
            android:textSize="@dimen/text_body_very_small"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <!-- PM2.5 -->
        <TextView
            android:id="@+id/aqiPm25Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PM2.5: 5 µg"
            android:textColor="@color/rd_text_secondary"
            android:textSize="@dimen/text_body_very_small"
            android:gravity="center" />

    </LinearLayout>

</com.hundewildnis.app.GlassCardView>
