<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="false">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/gl_bar"
            app:titleTextColor="?attr/colorOnPrimary" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- MODUS-AUSWAHL -->
            <!-- ═══════════════════════════════════════════════════ -->
            <com.hundewildnis.app.GlassCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/comm_header_mode"
                        android:textSize="@dimen/text_body_medium"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:layout_marginBottom="12dp" />

                    <RadioGroup
                        android:id="@+id/radioGroupMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/radioModeFree"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/comm_mode_free"
                            android:checked="true" />

                        <RadioButton
                            android:id="@+id/radioModeFocus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/comm_mode_focus" />

                    </RadioGroup>

                    <!-- Frequenz-Auswahl (nur bei Fokus-Modus) -->
                    <LinearLayout
                        android:id="@+id/layoutFocusFrequency"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/comm_select_frequency"
                            android:textSize="@dimen/text_body_medium"
                            android:textColor="?android:attr/textColorSecondary"
                            android:layout_marginBottom="8dp" />

                        <RadioGroup
                            android:id="@+id/radioGroupFocusFrequency"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <RadioButton
                                android:id="@+id/radioFreq108"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/comm_freq_108"
                                android:checked="true"
                                android:layout_marginBottom="12dp" />

                            <RadioButton
                                android:id="@+id/radioFreq216"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/comm_freq_216"
                                android:layout_marginBottom="12dp" />

                            <RadioButton
                                android:id="@+id/radioFreq324"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/comm_freq_324"
                                android:layout_marginBottom="12dp" />

                            <RadioButton
                                android:id="@+id/radioFreq432"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/comm_freq_432"
                                android:layout_marginBottom="12dp" />

                            <RadioButton
                                android:id="@+id/radioFreq648"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/comm_freq_648"
                                android:layout_marginBottom="12dp" />

                        </RadioGroup>
                    </LinearLayout>

                </LinearLayout>
            </com.hundewildnis.app.GlassCardView>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- CHART CARD -->
            <!-- ═══════════════════════════════════════════════════ -->
            <com.hundewildnis.app.GlassCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvChartTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/comm_header_chart"
                        android:textSize="@dimen/text_body_medium"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:layout_marginBottom="12dp" />

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/frequencyChart"
                        android:layout_width="match_parent"
                        android:layout_height="300dp" />

                </LinearLayout>
            </com.hundewildnis.app.GlassCardView>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- AKTUELLE FREQUENZ ANZEIGE -->
            <!-- ═══════════════════════════════════════════════════ -->
            <com.hundewildnis.app.GlassCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/gl_primary_stroke"
                app:strokeWidth="1.5dp"
                app:cardBackgroundColor="@color/gl_fill"
                android:id="@+id/cardFrequency"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/comm_current_freq_title"
                        android:textSize="@dimen/text_body_medium"
                        android:textColor="?android:attr/textColorPrimary"
                        android:alpha="0.7"
                        android:layout_marginBottom="8dp" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/tvCurrentFrequency"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--- Hz"
                            android:textSize="@dimen/text_body_medium"
                            android:textStyle="bold"
                            android:textColor="?android:attr/textColorPrimary"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <TextView
                            android:id="@+id/tvFrequencyMatch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎯"
                            android:textSize="@dimen/text_body_medium"
                            android:alpha="0"
                            android:scaleX="0"
                            android:scaleY="0"
                            app:layout_constraintTop_toTopOf="@id/tvCurrentFrequency"
                            app:layout_constraintBottom_toBottomOf="@id/tvCurrentFrequency"
                            app:layout_constraintStart_toEndOf="@id/tvCurrentFrequency"
                            android:layout_marginStart="12dp" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <ProgressBar
                        android:id="@+id/progressFrequency"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:max="100"
                        android:progress="0"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvFrequencyStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/comm_status_waiting"
                        android:textSize="@dimen/text_body_medium"
                        android:textColor="?android:attr/textColorPrimary" />

                </LinearLayout>
            </com.hundewildnis.app.GlassCardView>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- STEUERUNG -->
            <!-- ═══════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnStartStop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/comm_btn_start"
                    android:textSize="@dimen/text_body_medium"
                    android:textStyle="bold"
                    style="@style/Widget.App.Button.Primary" />

            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- EINSTELLUNGEN -->
            <!-- ═══════════════════════════════════════════════════ -->
            <com.hundewildnis.app.GlassCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/comm_header_feedback"
                        android:textSize="@dimen/text_body_medium"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchVibration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/comm_switch_vibration"
                        android:checked="true" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchSound"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/comm_switch_sound"
                        android:checked="false" />

                </LinearLayout>
            </com.hundewildnis.app.GlassCardView>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- STATISTIK -->
            <!-- ═══════════════════════════════════════════════════ -->
            <com.hundewildnis.app.GlassCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/comm_header_stats"
                        android:textSize="@dimen/text_body_medium"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvStats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/comm_stats_initial"
                        android:textSize="@dimen/text_body_medium"
                        android:textColor="?android:attr/textColorSecondary"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>
            </com.hundewildnis.app.GlassCardView>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- EXPORT BUTTONS -->
            <!-- ═══════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnExport"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📄 PDF"
                    android:enabled="false"
                    android:layout_marginEnd="8dp"
                    style="@style/Widget.App.Button.Primary" />

                <Button
                    android:id="@+id/btnShare"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/comm_btn_share"
                    android:enabled="false"
                    style="@style/Widget.App.Button.Primary" />

            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- HISTORIE -->
            <!-- ═══════════════════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/comm_header_history"
                android:textSize="@dimen/text_body_medium"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginBottom="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
