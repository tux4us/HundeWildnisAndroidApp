<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false">

    <com.google.android.material.appbar.AppBarLayout android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:titleTextColor="?attr/colorOnPrimary"
            app:navigationIcon="?attr/homeAsUpIndicator" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <!-- Icon -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="⛈️"
                android:textSize="64sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="Blitz-Donner-Distanzrechner"
                android:textColor="@color/rd_overlay_accent"
                android:textSize="@dimen/text_body_large"
                android:textStyle="bold" />

            <!-- Erklärung -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="Tippe im Moment des Blitzes auf BLITZ. Sobald Du den Donner hörst, tippe auf DONNER. Aus der gemessenen Zeit berechnet die App die ungefähre Entfernung des Gewitters."
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFlash"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="⚡ BLITZ"
                    android:textColor="@android:color/white"
                    app:backgroundTint="#F5A623" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnThunder"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:enabled="false"
                    android:text="🔊 DONNER"
                    android:textColor="@android:color/white"
                    app:backgroundTint="#5A6B7A" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvMeasureStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="Bereit für die Messung."
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp" />

            <!-- Rechenweg-Card (Lernfunktion) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCalculation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/rd_surface_alt"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="📐 Rechenweg"
                        android:textColor="@color/rd_overlay_accent"
                        android:textSize="@dimen/text_body_large"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStepTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvStepFormula"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp" />

                    <TextView
                        android:id="@+id/tvStepRuleOfThumb"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp"
                        android:textStyle="italic" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/rd_surface_alt" />

                    <TextView
                        android:id="@+id/tvStepResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvProximityLevel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:textSize="@dimen/text_body_large"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/recommendationContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvRecommendationIcon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:textSize="22sp" />

                        <TextView
                            android:id="@+id/tvRecommendation"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:lineSpacingExtra="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Trend-Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Verlauf dieser Messreihe"
                        android:textColor="@color/rd_overlay_accent"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMeasurementCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Noch keine Messung"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvTrendResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="@dimen/text_body_large"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp"
                        android:background="@color/rd_surface_alt" />

                    <TextView
                        android:id="@+id/tvApproachPlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🚗💨 Näherungsgeschwindigkeit &amp; Ankunftszeit erscheinen ab der 2. Messung."
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp" />

                    <!-- Kennzahlen-Block: Geschwindigkeit + ETA nebeneinander, groß und mit Icon -->
                    <LinearLayout
                        android:id="@+id/approachMetricsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <!-- Geschwindigkeit -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:orientation="vertical"
                            android:background="@drawable/bg_metric_tile"
                            android:padding="12dp"
                            android:gravity="center_horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="💨 GESCHWINDIGKEIT"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05" />

                            <TextView
                                android:id="@+id/tvSpeedValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="-- km/h"
                                android:textColor="@color/rd_overlay_accent"
                                android:textSize="26sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- ETA -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:orientation="vertical"
                            android:background="@drawable/bg_metric_tile"
                            android:padding="12dp"
                            android:gravity="center_horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⏱️ ANKUNFT IN"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05" />

                            <TextView
                                android:id="@+id/tvEtaValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="-- min"
                                android:textSize="26sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Rechenweg-Hinweis (klein, unter den Kacheln) -->
                    <TextView
                        android:id="@+id/tvApproachFormula"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp"
                        android:visibility="gone" />

                    <!-- Akute-Gefahr-Warnzeile (ersetzt die ETA-Kachel-Aussage unter 1 km) -->
                    <LinearLayout
                        android:id="@+id/approachDangerContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_danger_banner"
                        android:padding="12dp"
                        android:gravity="center_vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:text="🔴"
                            android:textSize="22sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Unter 1 km Entfernung – keine Ankunftszeit-Schätzung mehr sinnvoll: SOFORT Schutz suchen!"
                            android:textColor="@color/rd_danger_text"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:lineSpacingExtra="1dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:id="@+id/btnResetMeasurements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:text="Messreihe zurücksetzen"
                android:textColor="@color/rd_overlay_accent"
                app:strokeColor="@color/rd_overlay_accent" />

            <!-- Trennlinie zum zweiten Abschnitt -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="24dp"
                android:background="@color/rd_surface_alt" />

            <!-- TEIL 2: Vorhersage -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="🌩️ Gewitterrisiko-Vorhersage"
                android:textColor="@color/rd_overlay_accent"
                android:textSize="@dimen/text_body_large"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Zeigt die Gewittergefahr für die nächsten 12 Stunden an Deinem Standort, basierend auf dem CAPE-Wert (Energie für Gewitterbildung) von Open-Meteo, inklusive der wahrscheinlichen Richtung, aus der ein Gewitter herannaht."
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLoadForecast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Vorhersage für aktuellen Standort laden"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/rd_overlay_accent" />

            <ProgressBar
                android:id="@+id/forecastProgressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/forecastResultContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">

                    <TextView
                        android:id="@+id/tvForecastSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="2dp" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="#252525"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/rd_surface_alt"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/tvForecastDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:fontFamily="monospace"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Haftungshinweis: immer sichtbar, unabhängig davon ob Messung
                 und/oder Vorhersage genutzt wurden -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#252525"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/rd_surface_alt"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="⚠️ Wichtiger Hinweis"
                        android:textColor="#CCCCCC"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Alle Angaben in diesem Werkzeug sind rein rechnerische Näherungswerte auf Basis Deiner eigenen Messungen (Zeitpunkt von Blitz und Donner) bzw. einer Wettervorhersage. Reaktionszeit beim Tippen, Wind, Gelände und sich schnell ändernde Wetterbedingungen können zu erheblichen Abweichungen von Distanz, Geschwindigkeit, Ankunftszeit und Zugrichtung führen – Gewitter können ihre Richtung ändern oder neu entstehen. Die angezeigten Gebäude/Hütten in der Revier-Navigation sind aus OpenStreetMap-Daten ermittelt; ob sie vor Ort tatsächlich als geschlossener Blitzschutz geeignet sind, muss selbst geprüft werden. Die Werte ersetzen keine amtliche Unwetterwarnung und keine eigene Einschätzung der Lage vor Ort. Die Nutzung erfolgt auf eigene Verantwortung; für Schäden, die aus dem Vertrauen auf diese Berechnungen entstehen, wird keine Haftung übernommen."
                        android:textColor="#CCCCCC"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>