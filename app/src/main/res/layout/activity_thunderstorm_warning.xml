<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false">

    <com.google.android.material.appbar.AppBarLayout android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:titleTextColor="?attr/colorOnPrimary"
            app:navigationIcon="?attr/homeAsUpIndicator" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <!-- Icon -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="⛈️"
                android:textSize="64sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="@string/thunderstorm_layout_calculator_title"
                android:textColor="@color/rd_overlay_accent"
                android:textSize="@dimen/text_body_large"
                android:textStyle="bold" />

            <!-- Erklärung -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="@string/thunderstorm_layout_instructions"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFlash"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/thunderstorm_layout_btn_flash"
                    android:textColor="@android:color/white"
                    app:backgroundTint="#F5A623" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnThunder"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:enabled="false"
                    android:text="@string/thunderstorm_layout_btn_thunder"
                    android:textColor="@android:color/white"
                    app:backgroundTint="#5A6B7A" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvMeasureStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="@string/thunderstorm_layout_ready_for_measurement"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp" />

            <!-- Rechenweg-Card (Lernfunktion) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCalculation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/rd_surface_alt"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/thunderstorm_layout_calculation_title"
                        android:textColor="@color/rd_overlay_accent"
                        android:textSize="@dimen/text_body_large"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStepTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvStepFormula"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp" />

                    <TextView
                        android:id="@+id/tvStepRuleOfThumb"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp"
                        android:textStyle="italic" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/rd_surface_alt" />

                    <TextView
                        android:id="@+id/tvStepResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvProximityLevel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:textSize="@dimen/text_body_large"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/recommendationContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvRecommendationIcon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:textSize="22sp" />

                        <TextView
                            android:id="@+id/tvRecommendation"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:lineSpacingExtra="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Trend-Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/thunderstorm_layout_series_title"
                        android:textColor="@color/rd_overlay_accent"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMeasurementCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/thunderstorm_layout_no_measurement_yet"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvTrendResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="@dimen/text_body_large"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp"
                        android:background="@color/rd_surface_alt" />

                    <TextView
                        android:id="@+id/tvApproachPlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/thunderstorm_layout_approach_placeholder"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp" />

                    <!-- Kennzahlen-Block: Geschwindigkeit + ETA nebeneinander, groß und mit Icon -->
                    <LinearLayout
                        android:id="@+id/approachMetricsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <!-- Geschwindigkeit -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:orientation="vertical"
                            android:background="@drawable/bg_metric_tile"
                            android:padding="12dp"
                            android:gravity="center_horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/thunderstorm_layout_speed_label"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05" />

                            <TextView
                                android:id="@+id/tvSpeedValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="-- km/h"
                                android:textColor="@color/rd_overlay_accent"
                                android:textSize="26sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- ETA -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:orientation="vertical"
                            android:background="@drawable/bg_metric_tile"
                            android:padding="12dp"
                            android:gravity="center_horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/thunderstorm_layout_arrival_in_label"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05" />

                            <TextView
                                android:id="@+id/tvEtaValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="-- min"
                                android:textSize="26sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Rechenweg-Hinweis (klein, unter den Kacheln) -->
                    <TextView
                        android:id="@+id/tvApproachFormula"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp"
                        android:visibility="gone" />

                    <!-- Akute-Gefahr-Warnzeile (ersetzt die ETA-Kachel-Aussage unter 1 km) -->
                    <LinearLayout
                        android:id="@+id/approachDangerContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_danger_banner"
                        android:padding="12dp"
                        android:gravity="center_vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:text="🔴"
                            android:textSize="22sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/thunderstorm_layout_acute_danger_text"
                            android:textColor="@color/rd_danger_text"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:lineSpacingExtra="1dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:id="@+id/btnResetMeasurements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:text="@string/thunderstorm_layout_reset_series"
                android:textColor="@color/rd_overlay_accent"
                app:strokeColor="@color/rd_overlay_accent" />

            <!-- Trennlinie zum zweiten Abschnitt -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="24dp"
                android:background="@color/rd_surface_alt" />

            <!-- TEIL 2: Vorhersage -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/thunderstorm_layout_forecast_title"
                android:textColor="@color/rd_overlay_accent"
                android:textSize="@dimen/text_body_large"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/thunderstorm_layout_forecast_explanation"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLoadForecast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/thunderstorm_layout_load_forecast_button"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/rd_overlay_accent" />

            <ProgressBar
                android:id="@+id/forecastProgressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/forecastResultContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">

                    <TextView
                        android:id="@+id/tvForecastSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="2dp" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="#252525"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/rd_surface_alt"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/tvForecastDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:fontFamily="monospace"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Haftungshinweis: immer sichtbar, unabhängig davon ob Messung
                 und/oder Vorhersage genutzt wurden -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#252525"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/rd_surface_alt"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/thunderstorm_layout_important_note_title"
                        android:textColor="#CCCCCC"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/thunderstorm_layout_disclaimer"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>