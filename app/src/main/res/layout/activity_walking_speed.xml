<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#1B3A0A"
            app:titleTextColor="#FFFFFF" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Status -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🛑 Messung gestoppt"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:textAlignment="center"
                android:padding="16dp"
                android:background="#003b00"
                android:layout_marginBottom="16dp" />

            <!-- Aktuelle Geschwindigkeit -->
            <TextView
                android:id="@+id/tvCurrentSpeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aktuell: 0.0 km/h"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:padding="24dp"
                android:textColor="#2d5016"
                android:layout_marginBottom="24dp" />

            <!-- Geschwindigkeitslimit -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Geschwindigkeitswächter:"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/radioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <RadioButton
                    android:id="@+id/radioSpeed25"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tempo Geländetraining"
                    android:textSize="16sp"
                    android:padding="8dp" />

                <RadioButton
                    android:id="@+id/radioSpeed30"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tempo Strassentraining"
                    android:textSize="16sp"
                    android:padding="8dp"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/radioSpeed40"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tempo Alltagstraining"
                    android:textSize="16sp"
                    android:padding="8dp" />
            </RadioGroup>

            <!-- Messintervall -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Messintervall:"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/radioGroupInterval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <RadioButton
                    android:id="@+id/radioInterval30"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Alle 30 Sekunden"
                    android:textSize="16sp"
                    android:padding="8dp"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/radioInterval60"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Alle 60 Sekunden"
                    android:textSize="16sp"
                    android:padding="8dp" />
            </RadioGroup>

            <!-- Benachrichtigungsoptionen -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Benachrichtigungen:"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchVibration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Vibration"
                android:textSize="16sp"
                android:padding="8dp"
                android:checked="true" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchSound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ton"
                android:textSize="16sp"
                android:padding="8dp"
                android:checked="true"
                android:layout_marginBottom="32dp" />

            <!-- Start/Stop Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartStop"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="🏁 Messung starten"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                app:backgroundTint="#2d5016"
                android:textColor="#FFFFFF" />

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
