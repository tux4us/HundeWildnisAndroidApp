<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#1B3A0A"
            app:titleTextColor="#FFFFFF" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Status -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🛑 Messung gestoppt"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:textAlignment="center"
                android:padding="16dp"
                android:background="#003b00"
                android:layout_marginBottom="16dp" />

            <!-- Aktuelle Geschwindigkeit -->
            <TextView
                android:id="@+id/tvCurrentSpeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aktuell: 0.0 km/h"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:padding="12dp"
                android:textColor="#aa0000"
                android:layout_marginBottom="24dp" />

            <!-- Start/Stop Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartStop"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="🏁 Messung starten"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                app:backgroundTint="#2d5016"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="24dp" />

            <!-- Geschwindigkeitslimit -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Geschwindigkeitswächter:"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hier kannst Du Dein Trainingsszenario wählen. Ein Wechsel des Modus während des Trainings ist möglich (z.B. bei Wechsel von Geländetraining zu Strassentraining)."
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/radioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <RadioButton
                    android:id="@+id/radioSpeed25"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Wege- und Geländetraining"
                    android:textSize="16sp"
                    android:padding="8dp" />

                <RadioButton
                    android:id="@+id/radioSpeed30"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Alltags- und Strassentraining"
                    android:textSize="16sp"
                    android:padding="8dp"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/radioSpeed40"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Wandertraining"
                    android:textSize="16sp"
                    android:padding="8dp" />
            </RadioGroup>

            <!-- Messintervall -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Messintervall:"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hier kannst Du Dein Messintervall wählen. Ein Wechsel des Intervalls während des Trainings ist möglich. Bei längeren Trainingssessions empfiehlt sich ein 60 Sekunden Intervall."
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/radioGroupInterval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <RadioButton
                    android:id="@+id/radioInterval30"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Alle 30 Sekunden"
                    android:textSize="16sp"
                    android:padding="8dp"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/radioInterval60"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Alle 60 Sekunden"
                    android:textSize="16sp"
                    android:padding="8dp" />
            </RadioGroup>

            <!-- Benachrichtigungsoptionen -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Benachrichtigungen bei Überschreitung:"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchVibration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Vibration"
                android:textSize="16sp"
                android:padding="8dp"
                android:checked="true" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchSound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ton"
                android:textSize="16sp"
                android:padding="8dp"
                android:checked="true"
                android:layout_marginBottom="24dp" />

            <!-- Live-Diagramm -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/tvChartTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📊 Geschwindigkeitsverlauf"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:layout_marginBottom="8dp" />

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/speedChart"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Statistiken -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📈 Statistiken"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvStats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Starte Tracking um Statistiken zu sehen"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="14sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Export & Share Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExport"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="📄 PDF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    app:backgroundTint="#4a6135"
                    android:textColor="#FFFFFF"
                    android:enabled="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportGpx"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="🗺️ GPX"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    app:backgroundTint="#4a6135"
                    android:textColor="#FFFFFF"
                    android:enabled="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShare"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:text="📤 Teilen"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    app:backgroundTint="#2d5016"
                    android:textColor="#FFFFFF"
                    android:enabled="false" />
            </LinearLayout>

            <!-- Historie Überschrift -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🕒 Historie (Bisherige Messungen)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Liste der Sitzungen -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
