<?xml version="1.0" encoding="utf-8"?>
<com.hundewildnis.app.GlassCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp">

    <LinearLayout
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvInfoTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gerätename"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/rd_overlay_accent" />

        <TextView
            android:id="@+id/tvInfoSnippet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Zuletzt gesehen: --"
            android:textSize="12sp"
            android:textColor="@color/rd_text_secondary"
            android:layout_marginTop="2dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gl_divider"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Navigation starten:"
            android:textSize="12sp"
            android:textColor="@color/rd_text_primary"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.hundewildnis.app.GlassButton
                android:id="@+id/btnRouteDrive"
                style="@style/Widget.App.Button.Outlined.Primary"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:padding="0dp"
                android:text="🚗"
                android:textSize="20sp"
                app:cornerRadius="8dp" />

            <com.hundewildnis.app.GlassButton
                android:id="@+id/btnRouteWalk"
                style="@style/Widget.App.Button.Outlined.Primary"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:padding="0dp"
                android:text="🥾"
                android:textSize="20sp"
                app:cornerRadius="8dp" />

            <com.hundewildnis.app.GlassButton
                android:id="@+id/btnRouteBike"
                style="@style/Widget.App.Button.Outlined.Primary"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="🚲"
                android:textSize="20sp"
                app:cornerRadius="8dp" />

        </LinearLayout>

    </LinearLayout>

</com.hundewildnis.app.GlassCardView>
