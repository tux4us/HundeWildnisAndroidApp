<?xml version="1.0" encoding="utf-8"?>
<!-- ════════════════════════════════════════════════════════════════
     PERFEKT: Wero mit Link-Button UND QR-Code
     ════════════════════════════════════════════════════════════════ -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📱 Wero - Direkt und sicher"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vielen Dank für Deine Unterstützung 🙏🏽"
            android:textSize="16sp"
            android:textAlignment="center"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="24dp" />

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- OPTION 1: Mit Link (1 Gerät) -->
        <!-- ═══════════════════════════════════════════════════════ -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:strokeColor="#1B5E20"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📱 Direkt unterstützen"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Am einfachsten:\n1️⃣ Tippe auf den Button\n2️⃣ Wähle deine Bank\n3️⃣ Fertig!"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWeroLink"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Weiter zu Wero 📱"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    app:backgroundTint="#1B5E20"
                    android:textColor="#FFFFFF" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Trennlinie mit "ODER" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="?android:attr/textColorSecondary"
                android:alpha="0.3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  ODER  "
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorSecondary" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="?android:attr/textColorSecondary"
                android:alpha="0.3" />

        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- OPTION 2: Mit QR-Code (2 Geräte) -->
        <!-- ═══════════════════════════════════════════════════════ -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📱📱 QR-Code scannen (2 Geräte)"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textAlignment="center"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="QR-Code mit einem 2.Gerät scannen:"
                    android:textSize="13sp"
                    android:textAlignment="center"
                    android:textColor="?android:attr/textColorSecondary"
                    android:layout_marginBottom="12dp" />

                <!-- QR-Code Bild (ausklappbar) -->
                <LinearLayout
                    android:id="@+id/layoutQRCodeSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/ivWeroQR"
                        android:layout_width="280dp"
                        android:layout_height="280dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="Wero QR-Code zum Scannen"
                        android:background="#FFFEF0"
                        android:padding="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Banking-App öffnen → QR scannen → Fertig!"
                        android:textSize="12sp"
                        android:textAlignment="center"
                        android:textColor="?android:attr/textColorSecondary" />

                </LinearLayout>

                <!-- QR-Code anzeigen/ausblenden Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleQR"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="QR-Code anzeigen 📸"
                    app:cornerRadius="8dp"
                    style="@style/Widget.Material3.Button.OutlinedButton" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Info Box -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Unterstütze uns gern mit einem Betrag Deiner Wahl. Herzlichen Dank! 🙏🏽❤️"
            android:textSize="15sp"
            android:textAlignment="center"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="16dp" />

        <!-- Datenschutz -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔒 DATENSCHUTZ:\nWero wird von europäischen Banken betrieben. Deine Zahlungsdaten werden nicht an uns übermittelt."
            android:textSize="12sp"
            android:textAlignment="center"
            android:textColor="?android:attr/textColorSecondary"
            android:alpha="0.7"
            android:layout_marginBottom="16dp" />

        <!-- Schließen-Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseDialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Schließen"
            app:cornerRadius="8dp"
            style="@style/Widget.Material3.Button.TextButton" />

    </LinearLayout>
</ScrollView>