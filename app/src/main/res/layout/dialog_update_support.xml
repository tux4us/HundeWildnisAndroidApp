<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Icon/Emoji -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="🎉"
        android:textSize="@dimen/text_body_medium"
        android:layout_marginBottom="16dp" />

    <!-- Titel -->
    <TextView
        android:id="@+id/tvUpdateTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Neue Version verfügbar!"
        android:textSize="@dimen/text_body_medium"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Versionsnummer -->
    <TextView
        android:id="@+id/tvUpdateVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Version 9.31"
        android:textSize="@dimen/text_body_medium"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- ✅ NEU: ScrollView für langen Text -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxHeight="300dp"
        android:scrollbars="vertical"
        android:fadeScrollbars="false">

        <!-- Nachricht -->
        <TextView
            android:id="@+id/tvUpdateMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Die App HundeWildnis entsteht in vielen Stunden Arbeit und mit großer Leidenschaft – für Euch und Eure Hunde.\nDank Eurem Feedback entwickeln wir die App immer weiter.\nDamit wir die App auch künftig kostenlos anbieten können brauchen wir Deine Unterstützung.\n🤝 Jeder, gern auch regelmäßiger Beitrag ist eine große Wertschätzung für unsere Arbeit.\n\nVielen Dank für Deine Unterstützung 💚\nManuela und Jörg\n\nNatürlich kannst Du die App, auch ohne uns zu unterstützen, nutzen. 😇"
            android:textSize="@dimen/text_body_medium"
            android:lineSpacingMultiplier="1.2" />

    </ScrollView>

    <!-- Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="16dp" />

    <!-- Button Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Unterstützen Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSupport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💝 Ich möchte unterstützen"
            android:textSize="@dimen/text_body_medium"
            android:textStyle="bold"
            style="@style/Widget.Material3.Button"
            android:layout_marginBottom="12dp" />

        <!-- Später Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLater"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Jetzt nicht"
            android:textSize="@dimen/text_body_medium"
            style="@style/Widget.Material3.Button.OutlinedButton" />

    </LinearLayout>

</LinearLayout>