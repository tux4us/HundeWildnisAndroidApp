<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvPermTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permissions_title"
            android:textSize="@dimen/text_body_medium"
            android:textStyle="bold"
            android:textColor="@color/green_primary"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permissions_intro"
            android:textSize="@dimen/text_body_medium"
            android:layout_marginBottom="20dp" />

        <!-- Standort -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permissions_location_title"
            android:textStyle="bold"
            android:textSize="@dimen/text_body_medium"
            android:layout_marginBottom="4dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permissions_location_desc"
            android:textSize="@dimen/text_body_medium"
            android:layout_marginBottom="16dp" />

        <!-- Kamera & Medien -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permissions_camera_title"
            android:textStyle="bold"
            android:textSize="@dimen/text_body_medium"
            android:layout_marginBottom="4dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permissions_camera_desc"
            android:textSize="@dimen/text_body_medium"
            android:layout_marginBottom="16dp" />

        <!-- Mikrofon -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permissions_microphone_title"
            android:textStyle="bold"
            android:textSize="@dimen/text_body_medium"
            android:layout_marginBottom="4dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permissions_microphone_desc"
            android:textSize="@dimen/text_body_medium"
            android:layout_marginBottom="16dp" />

        <!-- Benachrichtigungen -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permissions_notifications_title"
            android:textStyle="bold"
            android:textSize="@dimen/text_body_medium"
            android:layout_marginBottom="4dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permissions_notifications_desc"
            android:textSize="@dimen/text_body_medium"
            android:layout_marginBottom="16dp" />

        <!-- Vibration -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permissions_vibration_title"
            android:textStyle="bold"
            android:textSize="@dimen/text_body_medium"
            android:layout_marginBottom="4dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permissions_vibration_desc"
            android:textSize="@dimen/text_body_medium"
            android:layout_marginBottom="20dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/dividerVertical"
            android:alpha="0.2"
            android:layout_marginBottom="20dp" />

        <!-- Anleitung Aktivierung -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permissions_manual_control_title"
            android:textStyle="bold"
            android:textSize="@dimen/text_body_medium"
            android:layout_marginBottom="8dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permissions_manual_control_steps"
            android:textSize="@dimen/text_body_medium"
            android:lineSpacingExtra="2dp"
            android:textColor="?android:attr/textColorSecondary" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
