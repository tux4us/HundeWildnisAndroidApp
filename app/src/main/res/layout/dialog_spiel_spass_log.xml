<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/spiel_spass_log_dauer_hint"
        android:layout_marginBottom="12dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editDauer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"/>
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/spiel_spass_log_bewertung_label"
        android:textStyle="bold"
        android:textSize="13sp"
        android:layout_marginBottom="4dp"/>

    <RadioGroup
        android:id="@+id/radioGroupBewertung"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <RadioButton android:id="@+id/radioBewertung1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🔴"/>
        <RadioButton android:id="@+id/radioBewertung2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🟡"/>
        <RadioButton android:id="@+id/radioBewertung3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🟢" android:checked="true"/>
        <RadioButton android:id="@+id/radioBewertung4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🟢🟢"/>

    </RadioGroup>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/spiel_spass_log_notizen_hint">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editNotizen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:minLines="2"/>
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
