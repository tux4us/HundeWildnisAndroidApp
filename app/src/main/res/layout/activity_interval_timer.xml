<?xml version="1.0" encoding="utf-8"?>
<!-- ════════════════════════════════════════════════════════════════
     activity_interval_timer.xml
     Laufender Intervall-Timer
     ════════════════════════════════════════════════════════════════ -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="120dp"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="12dp">

            <!-- Konfigurations-Zusammenfassung -->
            <TextView
                android:id="@+id/tvConfigSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/rd_text_secondary"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvDogName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/rd_text_primary"
                android:textSize="15sp"
                android:visibility="gone"
                android:layout_marginBottom="16dp" />

            <!-- ────────── TIMER DISPLAY CARD ────────── -->
            <com.hundewildnis.app.GlassCardView
                android:id="@+id/cardTimerDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp">

                    <!-- Phase-Label -->
                    <TextView
                        android:id="@+id/tvPhaseLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/interval_run_label_active_phase"
                        android:textColor="@color/rd_text_secondary"
                        android:textSize="13sp"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="4dp" />

                    <!-- Haupt-Countdown -->
                    <TextView
                        android:id="@+id/tvMainTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:45"
                        android:textColor="@color/rd_text_primary"
                        android:textSize="72sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="8dp" />

                    <!-- Status -->
                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/interval_run_status_ready"
                        android:textColor="@color/rd_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <!-- Phasen-Fortschrittsbalken -->
                    <ProgressBar
                        android:id="@+id/progressPhase"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="@color/gl_success"
                        android:progressBackgroundTint="@color/gl_fill_strong"
                        android:layout_marginBottom="16dp" />

                    <!-- Rundenanzeige -->
                    <TextView
                        android:id="@+id/tvRoundInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/interval_run_label_round"
                        android:textColor="@color/rd_text_primary"
                        android:textSize="15sp"
                        android:layout_marginBottom="12dp" />

                    <!-- Runden-Fortschrittsbalken -->
                    <ProgressBar
                        android:id="@+id/progressRounds"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:max="6"
                        android:progress="0"
                        android:progressTint="@color/gl_warning"
                        android:progressBackgroundTint="@color/gl_fill_strong" />

                </LinearLayout>
            </com.hundewildnis.app.GlassCardView>

            <!-- Gesamt-Zeit -->
            <TextView
                android:id="@+id/tvElapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/interval_run_label_total_elapsed"
                android:textColor="@color/rd_text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="24dp" />

            <!-- ────────── FERTIG-BEREICH ────────── -->
            <LinearLayout
                android:id="@+id/groupFinished"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <com.hundewildnis.app.GlassCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="24dp">

                        <TextView
                            android:id="@+id/tvFinishedIcon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🏆"
                            android:textSize="48sp"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tvFinishedTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/interval_finish_title_done"
                            android:textColor="@color/rd_text_primary"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tvFinishedRounds"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/rd_text_primary"
                            android:textSize="15sp"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvFinishedActive"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/gl_success"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>
                </com.hundewildnis.app.GlassCardView>

                <!-- Grid für Aktionen nach Abschluss -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/gridTimerFinished"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:spanCount="2" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:titleTextColor="@color/rd_text_primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ────────── STEUER-BUTTONS ────────── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/gridTimerControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/gl_bar"
        android:padding="8dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="2" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
