<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="false">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#1B3A0A"
            app:titleTextColor="#FFFFFF" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- FOTO -->
            <ImageView
                android:id="@+id/ivPhoto"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_dog_placeholder"
                android:contentDescription="Hundefoto"
                android:layout_marginBottom="16dp" />

            <!-- BASIS-DATEN -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📋 BASIS-DATEN"
                        android:textSize="@dimen/text_body_medium"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bello"
                        android:textSize="@dimen/text_body_medium"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvBreed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Labrador"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvGender"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rüde"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvNeutered"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kastriert: Ja"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvBirthDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Geboren: 01.01.2020"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvOriginCountry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Herkunft: -"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvColor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Farbe: Schwarz"
                        android:textSize="@dimen/text_body_medium" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- IDENTIFIKATION -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔖 IDENTIFIKATION"
                        android:textSize="@dimen/text_body_medium"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chip: 123456789"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvTax"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Steuernummer: -"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvTasso"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TASSO: -"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvPetPassport"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Heimtierausweis: -"
                        android:textSize="@dimen/text_body_medium" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- GESUNDHEIT -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💉 GESUNDHEIT"
                        android:textSize="@dimen/text_body_medium"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvVaccination"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Impfstatus: -"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvAdditionalVaccination"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Weitere Impfungen: -"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvDeworming"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Entwurmung: -"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvFleaTick"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Floh/Zecke: -"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvWeight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gewicht: -"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvShoulderHeight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Schulterhöhe: -"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvBodyLength"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Körperlänge: -"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvMedical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hinweise: -"
                        android:textSize="@dimen/text_body_medium" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- KONTAKTE -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👨‍⚕️ KONTAKTE"
                        android:textSize="@dimen/text_body_medium"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvVet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tierarzt: -"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvInsurance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Haftpflicht: -"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvHealthInsurance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Krankenvers.: -"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvOwner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Besitzer: -"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvEmergency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Notfall: -"
                        android:textSize="@dimen/text_body_medium" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- FUTTER & VERHALTEN -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🍖 FUTTER und VERHALTEN"
                        android:textSize="@dimen/text_body_medium"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvFood"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Futter: -"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvBehavior"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Verhalten: -"
                        android:textSize="@dimen/text_body_medium" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ════════ LÄUFIGKEIT ════════ -->
            <LinearLayout
                android:id="@+id/llHeatCycleSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Abschnitt-Trennlinie -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?android:attr/listDivider"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="12dp" />

                <!-- Abschnitt-Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌸 Läufigkeit"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <!-- Stats-Karte -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp"
                    xmlns:app="http://schemas.android.com/apk/res-auto">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvHeatAvg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ø Zykluslänge: —"
                            android:textSize="13sp"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvHeatNextDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nächste Läufigkeit: —"
                            android:textSize="13sp"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvHeatCountdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="13sp"
                            android:textStyle="italic" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Liste bisheriger Zyklen (wird dynamisch befüllt) -->
                <LinearLayout
                    android:id="@+id/llCycleList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="8dp" />

                <!-- Button: neue Läufigkeit eintragen -->
                <Button
                    android:id="@+id/btnAddHeatCycle"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🌸 Neue Läufigkeit eintragen"
                    android:layout_marginBottom="16dp" />

            </LinearLayout>



        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
