<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="false">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/gl_bar"
            app:titleTextColor="?attr/colorOnPrimary" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- FOTO -->
            <ImageView
                android:id="@+id/ivPhoto"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_dog_placeholder"
                android:contentDescription="@string/dog_photo_content_description"
                android:layout_marginBottom="16dp" />

            <!-- BASIS-DATEN -->
            <com.hundewildnis.app.GlassCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dog_view_section_basic_data"
                        android:textSize="@dimen/text_body_medium"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dog_view_name_placeholder"
                        android:textSize="@dimen/text_body_medium"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvBreed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dog_view_breed_placeholder"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvGender"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dog_view_gender_placeholder"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvNeutered"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dog_view_neutered_format"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvBirthDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dog_view_birth_date_format"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvOriginCountry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dog_view_origin_format"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvColor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dog_view_color_format"
                        android:textSize="@dimen/text_body_medium" />
                </LinearLayout>
            </com.hundewildnis.app.GlassCardView>

            <!-- GEMEINSAME ZEIT (nur sichtbar, wenn Start- oder Geburtsdatum bekannt) -->
            <com.hundewildnis.app.GlassCardView
                android:id="@+id/cardTogether"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dog_view_section_together"
                        android:textSize="@dimen/text_body_medium"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvTogetherHeadline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_headline_small"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvTogetherSince"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvTogetherDays"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvTogetherDogAge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvTogetherMilestone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_body_medium" />
                </LinearLayout>
            </com.hundewildnis.app.GlassCardView>

            <!-- TIMELINE (immer sichtbar) -->
            <Button
                android:id="@+id/btnOpenTimeline"
                style="@style/Widget.App.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dog_view_btn_timeline"
                android:layout_marginBottom="16dp" />

            <!-- IDENTIFIKATION -->
            <com.hundewildnis.app.GlassCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dog_view_section_identification"
                        android:textSize="@dimen/text_body_medium"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dog_view_chip_format"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvTax"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dog_view_tax_format"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvTasso"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dog_view_tasso_format"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvPetPassport"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dog_view_pet_passport_format"
                        android:textSize="@dimen/text_body_medium" />
                </LinearLayout>
            </com.hundewildnis.app.GlassCardView>

            <!-- GESUNDHEIT -->
            <com.hundewildnis.app.GlassCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dog_view_section_health"
                        android:textSize="@dimen/text_body_medium"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvVaccination"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dog_view_vaccination_format"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvAdditionalVaccination"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dog_view_additional_vaccination_format"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvDeworming"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dog_view_deworming_format"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvFleaTick"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dog_view_flea_tick_format"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvWeight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dog_view_weight_empty"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvShoulderHeight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dog_view_shoulder_height_format"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvBodyLength"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dog_view_body_length_format"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvMedical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dog_view_medical_notes_format"
                        android:textSize="@dimen/text_body_medium" />
                </LinearLayout>
            </com.hundewildnis.app.GlassCardView>

            <!-- KONTAKTE -->
            <com.hundewildnis.app.GlassCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dog_view_section_contacts"
                        android:textSize="@dimen/text_body_medium"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvVet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dog_view_vet_format"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvInsurance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dog_view_liability_format"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvHealthInsurance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dog_view_health_insurance_format"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvOwner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dog_view_owner_format"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvEmergency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dog_view_emergency_format"
                        android:textSize="@dimen/text_body_medium" />
                </LinearLayout>
            </com.hundewildnis.app.GlassCardView>

            <!-- FUTTER & VERHALTEN -->
            <com.hundewildnis.app.GlassCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dog_view_section_food_behavior"
                        android:textSize="@dimen/text_body_medium"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvFood"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dog_view_food_format"
                        android:textSize="@dimen/text_body_medium"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvBehavior"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dog_view_behavior_format"
                        android:textSize="@dimen/text_body_medium" />
                </LinearLayout>
            </com.hundewildnis.app.GlassCardView>

            <!-- ════════ VITALWERTE ════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Trennlinie -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?android:attr/listDivider"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="12dp" />

                <!-- Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dog_view_vitals_header"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <!-- Tabelle -->
                <LinearLayout
                    android:id="@+id/llVitalTable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="8dp" />

                <!-- Leer-Hinweis -->
                <TextView
                    android:id="@+id/tvVitalEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dog_view_vitals_empty_hint"
                    android:textSize="13sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone" />

                <!-- Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/btnStartPulscheck"
                        style="@style/Widget.App.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dog_view_btn_measure_pulse"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnOpenVitalList"
                        style="@style/Widget.App.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dog_view_btn_all_measurements" />

                </LinearLayout>

            </LinearLayout>

            <!-- ════════ LÄUFIGKEIT ════════ -->
            <LinearLayout
                android:id="@+id/llHeatCycleSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Abschnitt-Trennlinie -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?android:attr/listDivider"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="12dp" />

                <!-- Abschnitt-Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dog_view_heat_section_header"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <!-- Stats-Karte -->
                <com.hundewildnis.app.GlassCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="8dp"
                    xmlns:app="http://schemas.android.com/apk/res-auto">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvHeatAvg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dog_view_heat_avg_placeholder"
                            android:textSize="13sp"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvHeatNextDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dog_view_heat_next_placeholder"
                            android:textSize="13sp"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvHeatCountdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="13sp"
                            android:textStyle="italic" />

                    </LinearLayout>
                </com.hundewildnis.app.GlassCardView>

                <!-- Liste bisheriger Zyklen (wird dynamisch befüllt) -->
                <LinearLayout
                    android:id="@+id/llCycleList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="8dp" />

                <!-- Button: neue Läufigkeit eintragen -->
                <Button
                    android:id="@+id/btnAddHeatCycle"
                    style="@style/Widget.App.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dog_view_btn_add_heat_cycle"
                    android:layout_marginBottom="16dp" />

            </LinearLayout>



        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
