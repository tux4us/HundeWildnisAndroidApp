<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="false">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/gl_bar"
            app:titleTextColor="?attr/colorOnPrimary" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Hauptinhalt: Karte oben, ScrollView mit Funktionen unten -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- ── OSMDroid Karte (fest oben) ── -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="320dp">

            <org.osmdroid.views.MapView
                android:id="@+id/mapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.hundewildnis.app.GlassButton
                android:id="@+id/btnStopRouting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:text="@string/location_share_stop_routing_button"
                android:visibility="gone"
                android:textSize="12sp"
                app:icon="@android:drawable/ic_menu_close_clear_cancel"
                app:iconSize="16dp"
                style="@style/Widget.App.Button.Danger" />
        </FrameLayout>

        <!-- ── Alle Funktionen & Geräteliste (scrollbar) ── -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:background="@color/rd_surface_alt">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Karte 1: Eigene Freigabe -->
                <com.hundewildnis.app.GlassCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/location_share_card_title"
                                    android:textSize="@dimen/text_body_large"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/location_share_card_subtitle"
                                    android:textSize="@dimen/text_body_small"
                                    android:textColor="@color/rd_text_secondary" />
                            </LinearLayout>

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switchLocationShare"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            style="@style/Widget.App.TextInputLayout"
                            android:hint="@string/location_share_label_hint">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etLocationLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPersonName"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/tvShareStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/location_share_own_status_inactive"
                            android:textSize="@dimen/text_body_small"
                            android:textColor="@color/rd_text_secondary"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.hundewildnis.app.GlassCardView>

                <!-- Karte 2: WebDAV Warnung -->
                <com.hundewildnis.app.GlassCardView
                    android:id="@+id/cardNoWebDav"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/gl_warning_stroke"
                    app:strokeWidth="1.5dp"
                    app:cardBackgroundColor="@color/gl_fill"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/location_share_webdav_missing_title"
                            android:textColor="@color/gl_warning"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/location_share_webdav_missing_message"
                            android:textSize="12sp"
                            android:textColor="@color/gl_danger" />

                        <com.hundewildnis.app.GlassButton
                            android:id="@+id/btnOpenWebDavSettings"
                            style="@style/Widget.App.Button.Text.Warning"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_gravity="end"
                            android:text="@string/location_share_webdav_missing_button" />
                    </LinearLayout>
                </com.hundewildnis.app.GlassCardView>

                <!-- Karte 3: Karten-Optionen -->
                <com.hundewildnis.app.GlassCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/location_share_map_settings_title"
                                android:textStyle="bold" />

                            <com.hundewildnis.app.GlassButton
                                android:id="@+id/btnRefreshMap"
                                style="?attr/materialIconButtonStyle"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                app:icon="@drawable/ic_refresh"
                                app:iconTint="@color/rd_overlay_accent" />
                        </LinearLayout>

                        <!-- Routing-Profil Auswahl -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/location_share_routing_profile_label"
                            android:textSize="12sp"
                            android:textColor="@color/rd_text_secondary"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="4dp"/>

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/toggleRoutingProfile"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:singleSelection="true"
                            app:selectionRequired="true"
                            app:checkedButton="@+id/btnProfileFoot"
                            android:layout_marginBottom="8dp">

                            <com.hundewildnis.app.GlassButton
                                android:id="@+id/btnProfileFoot"
                                style="@style/Widget.App.Button.Outlined"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:text="@string/location_share_profile_foot"
                                android:textSize="12sp"
                                android:paddingHorizontal="12dp"
                                app:cornerRadius="8dp" />

                            <com.hundewildnis.app.GlassButton
                                android:id="@+id/btnProfileBike"
                                style="@style/Widget.App.Button.Outlined"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:text="@string/location_share_profile_bike"
                                android:textSize="12sp"
                                android:paddingHorizontal="12dp"
                                app:cornerRadius="8dp" />

                            <com.hundewildnis.app.GlassButton
                                android:id="@+id/btnProfileCar"
                                style="@style/Widget.App.Button.Outlined"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:text="@string/location_share_profile_car"
                                android:textSize="12sp"
                                android:paddingHorizontal="12dp"
                                app:cornerRadius="8dp" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchZoomActiveOnly"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/location_share_zoom_active_only"
                            android:checked="true" />

                        <TextView
                            android:id="@+id/tvMapStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/location_share_map_status_no_data"
                            android:textSize="@dimen/text_body_small"
                            android:textColor="@color/rd_text_secondary" />
                    </LinearLayout>
                </com.hundewildnis.app.GlassCardView>

                <!-- Karte 4: Geräteliste -->
                <com.hundewildnis.app.GlassCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvDeviceListHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/location_share_device_list_header_placeholder"
                            android:textColor="@color/rd_overlay_accent"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textAllCaps="true"
                            android:paddingBottom="8dp" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvDevices"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false" />
                    </LinearLayout>
                </com.hundewildnis.app.GlassCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
