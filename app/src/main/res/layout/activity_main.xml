<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#2d5016"
            app:titleTextColor="#FFFFFF"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <Button
                        android:id="@+id/btnBlog"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="@string/blog"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#2d5016" />

                    <Button
                        android:id="@+id/btnPages"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:text="@string/pages"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#2d5016" />

                    <Button
                        android:id="@+id/btnCourses"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="@string/courses"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#2d5016" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/blogRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:padding="8dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/pagesRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:padding="8dp"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/coursesRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:padding="8dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnLoadMore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:layout_marginBottom="80dp"
                    android:backgroundTint="#2d5016"
                    android:text="Weitere Beiträge laden"
                    android:textColor="#FFFFFF"
                    android:visibility="visible"
                    app:layout_anchor="@id/blogRecyclerView"
                    app:layout_anchorGravity="bottom" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="#2d5016"
                android:visibility="visible" />

            <TextView
                android:id="@+id/errorText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="80dp"
                android:padding="16dp"
                android:textAlignment="center"
                android:textSize="16sp"
                android:textColor="#2d5016"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- 2. DANN die Labels (über dem Overlay) -->
    <TextView
        android:id="@+id/fabLocationLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="72dp"
        android:layout_marginBottom="247dp"
        android:background="@android:color/transparent"
        android:padding="8dp"
        android:text="@string/location"
        android:textColor="#8fad6f"
        android:textStyle="bold"
        android:textSize="14sp"
        android:visibility="gone"
        android:clickable="false"
        android:focusable="false"
        android:elevation="16dp"
        tools:ignore="all" />

    <TextView
        android:id="@+id/fabCompassLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="72dp"
        android:layout_marginBottom="187dp"
        android:background="@android:color/transparent"
        android:padding="8dp"
        android:text="@string/compass"
        android:textColor="#8fad6f"
        android:textStyle="bold"
        android:textSize="14sp"
        android:visibility="gone"
        android:clickable="false"
        android:focusable="false"
        android:elevation="16dp"
        tools:ignore="all" />

    <TextView
        android:id="@+id/fabAltimeterLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="72dp"
        android:layout_marginBottom="127dp"
        android:background="@android:color/transparent"
        android:padding="8dp"
        android:text="@string/altimeter"
        android:textColor="#8fad6f"
        android:textStyle="bold"
        android:textSize="14sp"
        android:visibility="gone"
        android:clickable="false"
        android:focusable="false"
        android:elevation="16dp"
        tools:ignore="all" />


    <!-- 3. DANN die Mini-FABs (ganz oben) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="240dp"
        android:contentDescription="@string/location"
        android:src="@android:drawable/ic_dialog_map"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:backgroundTint="#2d5016"
        app:fabSize="normal"
        app:tint="@android:color/white"
        app:elevation="18dp"
        app:borderWidth="2dp"
        app:rippleColor="#8fad6f"
        tools:ignore="all" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCompass"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="180dp"
        android:contentDescription="@string/compass"
        android:src="@android:drawable/ic_menu_compass"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:backgroundTint="#2d5016"
        app:fabSize="normal"
        app:tint="@android:color/white"
        app:elevation="18dp"
        app:borderWidth="2dp"
        app:rippleColor="#8fad6f"
        tools:ignore="all" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAltimeter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="120dp"
        android:contentDescription="@string/altimeter"
        android:src="@android:drawable/stat_sys_upload"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:backgroundTint="#2d5016"
        app:fabSize="normal"
        app:tint="@android:color/white"
        app:elevation="18dp"
        app:borderWidth="2dp"
        app:rippleColor="#8fad6f"
        tools:ignore="all" />

    <!-- 4. Haupt-FAB ganz oben -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="80dp"
        android:contentDescription="Tools"
        android:src="@android:drawable/btn_star"
        app:backgroundTint="#2d5016"
        app:tint="@android:color/white"
        app:elevation="20dp"
        tools:ignore="all" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

