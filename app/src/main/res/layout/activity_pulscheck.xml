<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="false">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#2d5016"
            app:titleTextColor="#FFFFFF" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ══════════════════════════════════════════════════ -->
            <!-- ANLEITUNG                                          -->
            <!-- ══════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📋 Anleitung Pulsmessung"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"
                        android:textColor="?android:attr/textColorPrimary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1. Lege Zeige- und Mittelfinger an die Innenseite des Oberschenkels (A. femoralis) oder hinter das linke Ellbogengelenk auf die Brustwand.\n\n2. Starte den 15-Sekunden-Timer.\n\n3. Zähle die Herzschläge. Das Ergebnis × 4 = Herzfrequenz pro Minute.\n\n4. Atemfrequenz: Hebe- und Senkbewegungen des Brustkorbs zählen – ebenfalls 15 Sekunden, dann × 4."
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.4"
                        android:textColor="?android:attr/textColorSecondary" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════════════════ -->
            <!-- NORMALWERTE-REFERENZ                              -->
            <!-- ══════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📊 Normalwerte im Überblick"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp"
                        android:textColor="?android:attr/textColorPrimary" />

                    <!-- Puls-Referenzwert individuell (dynamisch) -->
                    <TextView
                        android:id="@+id/tvPulseReference"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="❤️ Herzfrequenz: wird geladen …"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#2d5016"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="❤️ Herzfrequenz nach Größe:\n  • Kleinhund (&lt; 30 cm): 100–160 /min\n  • Mittelhund (30–50 cm): 70–120 /min\n  • Großhund (&gt; 50 cm): 60–100 /min\n  • Welpen (&lt; 1 Jahr): bis 220 /min\n\n🫁 Atemfrequenz (Ruhe): 15–30 /min\n  • Welpen: bis 40 /min\n  • Bei Hitze/Aufregung: Hecheln normal\n\n🌡️ Körpertemperatur: 37,5–39,0 °C\n  • &gt; 39,5 °C: erhöht, beobachten\n  • &gt; 40,0 °C: Fieber → Tierarzt\n  • &lt; 37,0 °C: Unterkühlung → Tierarzt\n\n💉 Kapillarfüllzeit (KFZ): &lt; 2 Sekunden\n  • Finger auf Zahnfleisch drücken, loslassen\n  • Farbe sollte in &lt; 2 Sek. zurückkehren\n\n👁️ Schleimhäute: rosa, feucht\n🧠 Bewusstsein: alert, reaktiv"
                        android:textSize="12sp"
                        android:lineSpacingMultiplier="1.3"
                        android:textColor="?android:attr/textColorSecondary" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════════════════ -->
            <!-- BELASTUNGSSZENARIO                                -->
            <!-- ══════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚡ Belastungsszenario"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"
                        android:textColor="?android:attr/textColorPrimary" />

                    <Spinner
                        android:id="@+id/spinnerLoadScenario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/spinner_background"
                        android:padding="4dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════════════════ -->
            <!-- TIMER + PULS                                       -->
            <!-- ══════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="❤️ Herzfrequenz messen"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"
                        android:textColor="?android:attr/textColorPrimary" />

                    <!-- Timer-Anzeige -->
                    <TextView
                        android:id="@+id/tvPulseTimer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="15"
                        android:textSize="56sp"
                        android:textStyle="bold"
                        android:textAlignment="center"
                        android:textColor="#2d5016"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sekunden"
                        android:textSize="13sp"
                        android:textAlignment="center"
                        android:textColor="?android:attr/textColorSecondary"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartPulseTimer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="▶ Timer starten"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#2d5016"
                        app:cornerRadius="8dp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvPulseTimerHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Gezählte Schläge eingeben → × 4 = Herzfrequenz/min"
                        android:textSize="12sp"
                        android:textAlignment="center"
                        android:textColor="?android:attr/textColorSecondary"
                        android:layout_marginBottom="10dp" />

                    <!-- Schläge-Eingabe + Ergebnis nebeneinander -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Schläge gezählt"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPulseBeats"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:maxLength="3" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="  × 4 = "
                            android:textSize="16sp"
                            android:textColor="?android:attr/textColorSecondary" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Puls /min"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPulseResult"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:maxLength="3" />
                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                    <!-- Bewertungs-Badge -->
                    <TextView
                        android:id="@+id/tvPulseBadge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="13sp"
                        android:textAlignment="center"
                        android:layout_marginTop="4dp"
                        android:visibility="gone" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════════════════ -->
            <!-- ATEMFREQUENZ                                       -->
            <!-- ══════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🫁 Atemfrequenz (optional)"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp"
                        android:textColor="?android:attr/textColorPrimary" />

                    <!-- Timer -->
                    <TextView
                        android:id="@+id/tvRespTimer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="15"
                        android:textSize="40sp"
                        android:textStyle="bold"
                        android:textAlignment="center"
                        android:textColor="#2d5016"
                        android:layout_marginBottom="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartRespTimer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="▶ Timer starten"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#4a6135"
                        app:cornerRadius="8dp"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Atemzüge gezählt"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etRespBeats"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:maxLength="3" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="  × 4 = "
                            android:textSize="16sp"
                            android:textColor="?android:attr/textColorSecondary" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Atemfq. /min"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etRespResult"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:maxLength="3" />
                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════════════════ -->
            <!-- TEMPERATUR                                         -->
            <!-- ══════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🌡️ Körpertemperatur (optional)"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"
                        android:textColor="?android:attr/textColorPrimary" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Temperatur in °C (z.B. 38.5)"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:suffixText="°C">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTemperature"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:maxLength="4" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════════════════ -->
            <!-- KAPILLARFÜLLZEIT                                   -->
            <!-- ══════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="💉 Kapillarfüllzeit (optional)"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"
                        android:textColor="?android:attr/textColorPrimary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Finger auf Zahnfleisch drücken, loslassen – Sekunden bis Farbe zurückkommt"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:layout_marginBottom="10dp" />

                    <!-- Auswahl-Buttons: 1s / 2s / 3s / >3s -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCrt1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="1s"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#4a6135"
                            app:cornerRadius="8dp"
                            android:layout_marginEnd="4dp"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            app:strokeColor="#4a6135" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCrt2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="2s ✓"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#2d5016"
                            app:cornerRadius="8dp"
                            android:layout_marginEnd="4dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCrt3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="3s"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#E65100"
                            app:cornerRadius="8dp"
                            android:layout_marginEnd="4dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCrt4"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text=">3s"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#B00020"
                            app:cornerRadius="8dp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCrtSelected"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:textAlignment="center"
                        android:layout_marginTop="6dp"
                        android:textColor="?android:attr/textColorSecondary" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════════════════ -->
            <!-- SCHLEIMHAUTFARBE                                  -->
            <!-- ══════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="👁️ Schleimhautfarbe (optional)"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"
                        android:textColor="?android:attr/textColorPrimary" />

                    <Spinner
                        android:id="@+id/spinnerMucousColor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/spinner_background"
                        android:padding="4dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════════════════ -->
            <!-- BEWUSSTSEINSZUSTAND                               -->
            <!-- ══════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🧠 Bewusstseinszustand (optional)"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"
                        android:textColor="?android:attr/textColorPrimary" />

                    <Spinner
                        android:id="@+id/spinnerConsciousness"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/spinner_background"
                        android:padding="4dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════════════════ -->
            <!-- NOTIZEN / KONTEXT                                  -->
            <!-- ══════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📝 Notizen / Beobachtungen"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"
                        android:textColor="?android:attr/textColorPrimary" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Aktuelle Bedingungen, Beobachtungen, Auffälligkeiten …"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNotes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"
                            android:minLines="3"
                            android:maxLines="6"
                            android:gravity="top" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════════════════ -->
            <!-- AKTIONS-BUTTONS                                    -->
            <!-- ══════════════════════════════════════════════════ -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="💾 Messung speichern"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                app:backgroundTint="#2d5016"
                app:cornerRadius="12dp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTransferToEmergency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:text="🚨 In Notfallmeldung übernehmen"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                app:backgroundTint="#B00020"
                app:cornerRadius="12dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="📋 Alle Messungen anzeigen"
                android:textSize="14sp"
                android:textColor="#2d5016"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="#2d5016"
                app:cornerRadius="12dp"
