<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Hunde-Karten Container -->
            <LinearLayout
                android:id="@+id/layoutDogCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Wählen Sie einen Hund:"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <include
                    android:id="@+id/dogCard1"
                    layout="@layout/item_dog_card" />

                <include
                    android:id="@+id/dogCard2"
                    layout="@layout/item_dog_card" />

                <include
                    android:id="@+id/dogCard3"
                    layout="@layout/item_dog_card" />
            </LinearLayout>

            <!-- Keine Hunde Nachricht -->
            <TextView
                android:id="@+id/tvNoDogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Keine Hunde in den Stammdaten angelegt.\n\nBitte legen Sie zuerst mindestens einen Hund an."
                android:textAlignment="center"
                android:textSize="16sp"
                android:padding="32dp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
