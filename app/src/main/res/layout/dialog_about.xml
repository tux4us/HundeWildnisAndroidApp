<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <ImageView
        android:id="@+id/ivAboutLogo"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@mipmap/ic_launcher_hundewildnis"
        android:padding="4dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvAboutTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HundeWildnis"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/green_primary"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvAboutVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Version 1.0.0"
        android:textSize="14sp"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginBottom="24dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/dividerVertical"
        android:alpha="0.2"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Anbieter:"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorSecondary"
        android:textAllCaps="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="HundeWildnisSchule Manuela Ulbricht und Peter Jörg Ulbricht GbR"
        android:textSize="15sp"
        android:textColor="?android:attr/textColorPrimary"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Webadresse:"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorSecondary"
        android:textAllCaps="true" />

    <TextView
        android:id="@+id/tvAboutWeb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="www.wildnislehrer.com"
        android:textSize="15sp"
        android:textColor="@color/green_primary"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fehlermeldungen an:"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorSecondary"
        android:textAllCaps="true" />

    <TextView
        android:id="@+id/tvAboutEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="hundewildnisschuleapp@online.de"
        android:textSize="15sp"
        android:textColor="@color/green_primary"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Entwickelt mit Herz, Erfahrung und Liebe ❤️"
        android:textSize="14sp"
        android:textStyle="italic"
        android:gravity="center"
        android:textColor="?android:attr/textColorSecondary" />

</LinearLayout>
