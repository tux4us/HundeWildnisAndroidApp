<?xml version="1.0" encoding="utf-8"?>
<com.hundewildnis.app.GlassCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="100dp"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        android:gravity="center">

        <!-- Uhrzeit -->
        <TextView
            android:id="@+id/windTimeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:00"
            android:textColor="@color/rd_overlay_accent"
            android:textSize="@dimen/text_body_medium"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <!-- Richtungspfeil – groß -->
        <TextView
            android:id="@+id/windArrowText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↓"
            android:textColor="@color/rd_text_primary"
            android:textSize="26sp"
            android:layout_marginBottom="4dp" />

        <!-- Windgeschwindigkeit -->
        <TextView
            android:id="@+id/windSpeedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15 km/h"
            android:textColor="@color/gl_success"
            android:textSize="@dimen/text_body_small"
            android:textStyle="bold"
            android:layout_marginBottom="2dp" />

        <!-- Böen -->
        <TextView
            android:id="@+id/windGustText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Böen: 25"
            android:textColor="@color/rd_text_secondary"
            android:textSize="@dimen/text_body_very_small"
            android:layout_marginBottom="4dp" />

        <!-- Beaufort -->
        <TextView
            android:id="@+id/windBeaufortText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bft 2"
            android:textColor="@color/gl_success"
            android:textSize="@dimen/text_body_small"
            android:textStyle="bold" />

    </LinearLayout>

</com.hundewildnis.app.GlassCardView>
