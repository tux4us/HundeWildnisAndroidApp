<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/rd_surface_alt">

    <LinearLayout
        android:id="@+id/poiContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <!-- Haupt-Info: Icon, Name, Entfernung -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Icon & Kategorie -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="12dp">

                <TextView
                    android:id="@+id/poiIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🐕"
                    android:textSize="@dimen/text_body_medium" />

                <TextView
                    android:id="@+id/poiCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/poi_item_category_placeholder"
                    android:textSize="@dimen/text_body_medium"
                    android:textColor="#999999"
                    android:textAlignment="center"
                    android:maxWidth="88dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Name & Details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/poiName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/poi_item_name_placeholder"
                    android:textSize="@dimen/text_body_medium"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <!-- Entfernung & Richtung -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/poiDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/poi_item_distance_placeholder"
                        android:textSize="@dimen/text_body_medium"
                        android:textColor="@color/rd_overlay_accent"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" • "
                        android:textColor="#666666" />

                    <TextView
                        android:id="@+id/poiDirection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/poi_item_direction_placeholder"
                        android:textSize="@dimen/text_body_medium"
                        android:textColor="#999999" />
                </LinearLayout>

            </LinearLayout>

            <!-- Hinweis: Tap öffnet Details (nicht direkt Navigation) -->
            <TextView
                android:id="@+id/poiMoreHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/poi_item_more_hint"
                android:textSize="@dimen/text_body_medium"
                android:textColor="#999999"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- ═══════════════════════════════════════════ -->
        <!-- ✅ ERWEITERTE DETAILS (konditionell sichtbar) -->
        <!-- ═══════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/poiDetailsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:paddingTop="8dp"
            android:visibility="gone">

            <!-- Trennlinie -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#555555"
                android:layout_marginBottom="8dp" />

            <!-- Adresse -->
            <LinearLayout
                android:id="@+id/addressLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="@string/poi_label_address"
                    android:textSize="@dimen/text_body_medium"
                    android:textColor="#999999" />

                <TextView
                    android:id="@+id/poiAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/poi_item_address_placeholder"
                    android:textSize="@dimen/text_body_medium"
                    android:textColor="#CCCCCC" />
            </LinearLayout>

            <!-- Telefon -->
            <LinearLayout
                android:id="@+id/phoneLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="@string/poi_label_phone"
                    android:textSize="@dimen/text_body_medium"
                    android:textColor="#999999" />

                <TextView
                    android:id="@+id/poiPhone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/poi_item_phone_placeholder"
                    android:textSize="@dimen/text_body_medium"
                    android:textColor="#ffffff"
                    android:autoLink="phone" />
            </LinearLayout>

            <!-- Website -->
            <LinearLayout
                android:id="@+id/websiteLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="@string/poi_label_website"
                    android:textSize="@dimen/text_body_medium"
                    android:textColor="#999999" />

                <TextView
                    android:id="@+id/poiWebsite"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/poi_item_website_placeholder"
                    android:textSize="@dimen/text_body_medium"
                    android:textColor="@color/rd_overlay_accent"
                    android:autoLink="web" />
            </LinearLayout>

            <!-- Öffnungszeiten -->
            <LinearLayout
                android:id="@+id/hoursLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="@string/poi_label_hours"
                    android:textSize="@dimen/text_body_medium"
                    android:textColor="#999999" />

                <TextView
                    android:id="@+id/poiHours"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/poi_item_hours_placeholder"
                    android:textSize="@dimen/text_body_medium"
                    android:textColor="#CCCCCC" />
            </LinearLayout>

            <!-- Beschreibung -->
            <LinearLayout
                android:id="@+id/descriptionLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="@string/poi_label_info"
                    android:textSize="@dimen/text_body_medium"
                    android:textColor="#999999" />

                <TextView
                    android:id="@+id/poiDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/poi_item_description_placeholder"
                    android:textSize="@dimen/text_body_medium"
                    android:textColor="#CCCCCC"
                    android:maxLines="3"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Betreiber -->
            <LinearLayout
                android:id="@+id/operatorLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="@string/poi_label_operator"
                    android:textSize="@dimen/text_body_medium"
                    android:textColor="#999999" />

                <TextView
                    android:id="@+id/poiOperator"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/poi_item_operator_placeholder"
                    android:textSize="@dimen/text_body_medium"
                    android:textColor="#CCCCCC" />
            </LinearLayout>

            <!-- Zugang -->
            <LinearLayout
                android:id="@+id/accessLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="@string/poi_label_access"
                    android:textSize="@dimen/text_body_medium"
                    android:textColor="#999999" />

                <TextView
                    android:id="@+id/poiAccess"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/poi_item_access_placeholder"
                    android:textSize="@dimen/text_body_medium"
                    android:textColor="#CCCCCC" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>