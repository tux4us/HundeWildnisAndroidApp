<?xml version="1.0" encoding="utf-8"?>
<!-- ════════════════════════════════════════════════════════════════
     activity_hlw_timer.xml - AUTOMATISCHES METRONOM
     Kein Button-Drücken! Nur Metronom-Takt befolgen
     ════════════════════════════════════════════════════════════════ -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.google.android.material.appbar.AppBarLayout android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="false">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/gl_danger_fill"
            app:titleTextColor="@color/rd_text_primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:paddingBottom="80dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <!-- Gesamt-Zeit -->
            <TextView
                android:id="@+id/tvElapsedTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textSize="@dimen/text_body_medium"
                android:textStyle="bold"
                android:textColor="@color/rd_text_primary" />

            <!-- Nächster Puls-Check -->
            <TextView
                android:id="@+id/tvNextPulseCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/hlw_timer_placeholder_pulse_check_countdown"
                android:textSize="@dimen/text_body_medium"
                android:textColor="@color/rd_text_primary" />

            <!-- Zyklen -->
            <TextView
                android:id="@+id/tvCycleCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/hlw_timer_placeholder_cycle_count"
                android:textSize="@dimen/text_body_medium"
                android:textColor="@color/rd_text_primary" />

            <!-- Instruktionen -->
            <TextView
                android:id="@+id/tvInstructions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/hlw_timer_placeholder_ready"
                android:textSize="@dimen/text_body_medium"
                android:textStyle="bold"
                android:textColor="@color/rd_text_primary"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvPhase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text=""
                android:textSize="@dimen/text_body_medium"
                android:textColor="@color/rd_text_primary"
                android:gravity="center" />

            <!-- Herz-Icon (blinkt im Takt) -->
            <TextView
                android:id="@+id/tvHeartBeat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="💓"
                android:textSize="@dimen/text_body_medium" />

            <!-- KOMPRESSIONSPHASE -->
            <com.hundewildnis.app.GlassCardView
                android:id="@+id/cardCompressionPhase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvPhaseTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hlw_timer_placeholder_phase_time_compression"
                        android:textSize="@dimen/text_body_medium"
                        android:textStyle="bold"
                        android:textColor="@color/rd_text_primary"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/tvCompressionCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="0 / 30"
                        android:textSize="@dimen/text_body_medium"
                        android:textColor="@color/rd_text_primary"
                        android:gravity="center" />

                    <ProgressBar
                        android:id="@+id/progressPhase"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:max="30"
                        android:progress="0"
                        android:progressTint="@color/gl_success" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/hlw_timer_follow_metronome_hint"
                        android:textSize="@dimen/text_body_medium"
                        android:textColor="@color/rd_text_secondary"
                        android:gravity="center" />

                </LinearLayout>

            </com.hundewildnis.app.GlassCardView>

            <!-- BEATMUNGSPHASE -->
            <com.hundewildnis.app.GlassCardView
                android:id="@+id/cardVentilationPhase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:visibility="gone"
                app:strokeColor="@color/gl_warning_stroke"
                app:strokeWidth="1.5dp"
                app:cardBackgroundColor="@color/gl_fill"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/tvVentilationTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hlw_timer_placeholder_phase_time_ventilation"
                        android:textSize="@dimen/text_body_medium"
                        android:textStyle="bold"
                        android:textColor="@color/rd_text_primary"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/hlw_timer_ventilate_now_instruction"
                        android:textSize="@dimen/text_body_medium"
                        android:textStyle="bold"
                        android:textColor="@color/rd_text_primary"
                        android:gravity="center" />

                </LinearLayout>

            </com.hundewildnis.app.GlassCardView>

            <!-- Puls-Check Erinnerung -->
            <com.hundewildnis.app.GlassCardView
                android:id="@+id/cardPulseCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:visibility="gone"
                app:strokeColor="@color/gl_info_stroke"
                app:strokeWidth="1.5dp"
                app:cardBackgroundColor="@color/gl_fill"
                app:cardCornerRadius="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp"
                    android:text="@string/hlw_timer_check_pulse_instruction"
                    android:textSize="@dimen/text_body_medium"
                    android:textStyle="bold"
                    android:textColor="@color/rd_text_primary"
                    android:gravity="center" />

            </com.hundewildnis.app.GlassCardView>

            <!-- PERMANENTE INSTRUKTION -->
            <com.hundewildnis.app.GlassCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="@string/hlw_timer_permanent_instruction"
                    android:textSize="@dimen/text_body_medium"
                    android:textColor="@color/gl_warning"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp" />

            </com.hundewildnis.app.GlassCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#000000">

        <com.hundewildnis.app.GlassButton
            android:id="@+id/btnReset"
            style="@style/Widget.App.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/hlw_timer_button_reset" />

        <com.hundewildnis.app.GlassButton
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/hlw_timer_button_start"
            style="@style/Widget.App.Button.Success" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
