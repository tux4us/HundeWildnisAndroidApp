<?xml version="1.0" encoding="utf-8"?>
<com.hundewildnis.app.GlassCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚨"
            android:textSize="@dimen/text_body_medium"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:id="@+id/reportClickArea"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvReportDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01.01.2024 12:00"
                android:textSize="@dimen/text_body_medium"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <TextView
                android:id="@+id/tvReportSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/emergency_placeholder_symptom"
                android:textSize="@dimen/text_body_medium"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnDeleteReport"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@color/gl_danger"
            android:contentDescription="@string/emergency_delete_content_description" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▶"
            android:textSize="@dimen/text_body_medium"
            android:textColor="@color/gl_danger"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</com.hundewildnis.app.GlassCardView>
