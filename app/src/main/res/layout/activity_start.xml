<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="false">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#1B3A0A"
            app:titleTextColor="#FFFFFF" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Header - FIX oben -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:text="@string/start_header_text"
            android:textSize="@dimen/text_headline_medium"
            android:textStyle="italic"
            android:textAlignment="center"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:textColor="?android:attr/textColorPrimary" />

        <!-- NEU: Blog-Preview Card für activity_start.xml -->
        <com.google.android.material.card.MaterialCardView
            xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/cardLatestBlogPost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header: "Neuester Blog-Beitrag" -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:background="#2d5016"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="💬 Neuester Blog-Beitrag"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alle anzeigen ›"
                        android:textColor="#A4B395"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Blog-Bild (optional) -->
                <ImageView
                    android:id="@+id/blogPreviewImage"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="Blog-Bild" />

                <!-- Blog-Inhalt -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Titel -->
                    <TextView
                        android:id="@+id/blogPreviewTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Lädt..."
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="?android:textColorPrimary"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <!-- Datum -->
                    <TextView
                        android:id="@+id/blogPreviewDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="?android:textColorSecondary" />

                    <!-- Excerpt -->
                    <TextView
                        android:id="@+id/blogPreviewExcerpt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text=""
                        android:textSize="14sp"
                        android:textColor="?android:textColorSecondary"
                        android:maxLines="2"
                        android:ellipsize="end" />
                </LinearLayout>

                <!-- Loading Indicator -->
                <ProgressBar
                    android:id="@+id/blogPreviewLoading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="32dp"
                    android:indeterminateTint="#2d5016"
                    android:visibility="visible" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Scrollable Buttons -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollViewContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fillViewport="false"
            android:clipToPadding="false"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="20dp"
                android:paddingBottom="140dp">

                <!-- GRUPPE 1: Wochen-Übungen -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Übungen der Woche"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="?android:attr/textColorSecondary"
                            android:layout_marginBottom="8dp"
                            android:layout_marginStart="4dp"/>

                        <!-- Button 1: Übung der Woche -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDailyExercise"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="64dp"
                            android:text="🦮📖 Übung der Woche"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp"
                            app:backgroundTint="#2d5016"
                            android:textColor="#FFFFFF"
                            android:layout_marginBottom="8dp"
                            app:iconGravity="start" />

                        <!-- Button 2: Meditation der Woche -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDailyMeditation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="64dp"
                            android:text="🧘🐕 Meditationsübung"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp"
                            app:backgroundTint="#4a6135"
                            android:textColor="#FFFFFF"
                            app:iconGravity="start" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- GRUPPE 2: Trainingswerkzeuge -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Trainingswerkzeuge"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="?android:attr/textColorSecondary"
                            android:layout_marginBottom="8dp"
                            android:layout_marginStart="4dp"/>

                        <!-- Button 3: Geh-Geschwindigkeit -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnWalkingSpeed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="64dp"
                            android:text="⏱️🔔 Tempo - Trainer"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp"
                            app:backgroundTint="#5a7145"
                            android:textColor="#FFFFFF"
                            android:layout_marginBottom="8dp"
                            app:iconGravity="start" />

                        <!-- Button 4: Kommunikation -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCommunication"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="64dp"
                            android:text="🗣️🎤 Sprach - Trainer"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp"
                            app:backgroundTint="#6a8255"
                            android:textColor="#FFFFFF"
                            android:layout_marginBottom="8dp"
                            app:iconGravity="start" />

                        <!-- ✅ Button 5: Trainingstagebuch -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTrainingDiary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="64dp"
                            android:text="🦮📖 Hundetraining"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp"
                            app:backgroundTint="#4C6238"
                            android:textColor="#FFFFFF"
                            app:iconGravity="start" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- GRUPPE 3: Outdoorwerkzeuge -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Outdoorwerkzeuge"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="?android:attr/textColorSecondary"
                            android:layout_marginBottom="8dp"
                            android:layout_marginStart="4dp"/>

                        <!-- Button 6: Tagesnotizen -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDailyNotes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="64dp"
                            android:text="📝📸 Tagesnotizen"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp"
                            app:backgroundTint="#43592F"
                            android:textColor="#FFFFFF"
                            android:layout_marginBottom="8dp" />

                        <!-- Button 7: Wetter -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnWeather"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="64dp"
                            android:text="🌦💦 Revier - Wetter"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp"
                            app:backgroundTint="#354923"
                            android:textColor="#FFFFFF"
                            android:layout_marginBottom="8dp" />

                        <!-- Button 8: Standort -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLocation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="64dp"
                            android:text="🗺🛰 Revier - Navigation"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp"
                            app:backgroundTint="#234210"
                            android:textColor="#FFFFFF"
                            android:layout_marginBottom="8dp" />

                        <!-- Button 9: Kompass -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCompass"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="64dp"
                            android:text="🧭🌐 Kompass"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp"
                            app:backgroundTint="#213A10"
                            android:textColor="#FFFFFF"
                            android:layout_marginBottom="8dp" />

                        <!-- Button 10: Höhenmesser -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAltimeter"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="64dp"
                            android:text="⛰️〽️ Höhenmesser"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp"
                            app:backgroundTint="#1e340e"
                            android:textColor="#FFFFFF" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- GRUPPE 4: Hunde & Notfall -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hund und Notfall"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="?android:attr/textColorSecondary"
                            android:layout_marginBottom="8dp"
                            android:layout_marginStart="4dp"/>

                        <!-- Button 11: Stammdaten -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDogProfiles"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="64dp"
                            android:text="🦮 Hunde Stammdaten"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp"
                            app:backgroundTint="#01579B"
                            android:textColor="#FFFFFF"
                            android:layout_marginBottom="8dp" />

                        <!-- Button 12: NOTFALL-BUTTON -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEmergency"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="64dp"
                            android:text="🚨 NOTFALL 🚨"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:backgroundTint="#BD0000"
                            app:cornerRadius="12dp"
                            app:iconGravity="start" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- GRUPPE 5: Informationen und Lernen -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Informationen und Lernen"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="?android:attr/textColorSecondary"
                            android:layout_marginBottom="8dp"
                            android:layout_marginStart="4dp"/>

                        <!-- Button 13: Blog Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnNavBlog"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="64dp"
                            android:text="💬 HundeWildnis Blog"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp"
                            app:backgroundTint="#283C16"
                            android:textColor="#FFFFFF"
                            android:layout_marginBottom="8dp"
                            app:iconGravity="start" />

                        <!-- Button 14: Seiten Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnNavPages"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="64dp"
                            android:text="ℹ️ HundeWildnis Seiten"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp"
                            app:backgroundTint="#364E21"
                            android:textColor="#FFFFFF"
                            android:layout_marginBottom="8dp"
                            app:iconGravity="start" />

                        <!-- Button 15: Kurse Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnNavCourses"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="64dp"
                            android:text="🎓 Online-Kurse"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp"
                            app:backgroundTint="#4F6A36"
                            android:textColor="#FFFFFF"
                            app:iconGravity="start" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- GRUPPE 6: App-Service -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="App-Service"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="?android:attr/textColorSecondary"
                            android:layout_marginBottom="8dp"
                            android:layout_marginStart="4dp"/>

                        <!-- Button 16: Backup & Restore -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBackup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="64dp"
                            android:text="📦💾 Backup App Daten"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp"
                            app:backgroundTint="#003A3C"
                            android:textColor="#FFFFFF"
                            android:layout_marginBottom="8dp" />

                        <!-- Button 17: Unterstützung -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSupport"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="64dp"
                            android:text="💖🤝 Deine Unterstützung"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp"
                            app:backgroundTint="#006064"
                            android:textColor="#FFFFFF"
                            app:iconGravity="start" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:backgroundTint="#1B3A0A"
        app:itemIconTint="@color/bottom_nav_colors"
        app:itemTextColor="@color/bottom_nav_colors"
        app:itemRippleColor="#338fad6f"
        app:itemActiveIndicatorStyle="@style/Widget.App.BottomNav.Indicator"
        app:itemTextAppearanceActive="@style/TextAppearance.App.BottomNav.Active"
        app:itemTextAppearanceInactive="@style/TextAppearance.App.BottomNav.Inactive"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_bottom_navigation"
        app:elevation="16dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>