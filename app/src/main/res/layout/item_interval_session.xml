<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/item_interval_session.xml -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_large">

        <!-- Datum + Status (eine Zeile) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvSessionDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="@dimen/text_body_small"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSessionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_label_small"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Hund (optional) -->
        <TextView
            android:id="@+id/tvSessionDog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_body_small"
            android:layout_marginBottom="4dp" />

        <!-- Zusammenfassung -->
        <TextView
            android:id="@+id/tvSessionSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_body_medium"
            android:layout_marginBottom="4dp" />

        <!-- Aktive Zeit -->
        <TextView
            android:id="@+id/tvSessionActive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_body_small"
            android:textColor="@color/green_secondary"
            android:layout_marginBottom="12dp" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSessionShare"
                style="@style/Widget.App.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/interval_finish_btn_share"
                android:textSize="@dimen/text_label_small" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSessionDelete"
                style="@style/Widget.App.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/start_delete"
                android:textColor="#C0392B"
                app:strokeColor="#C0392B"
                android:textSize="@dimen/text_label_small" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
