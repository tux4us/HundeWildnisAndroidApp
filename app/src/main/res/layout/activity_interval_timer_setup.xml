<?xml version="1.0" encoding="utf-8"?>
<!-- ════════════════════════════════════════════════════════════════
     activity_interval_timer_setup.xml
     Konfigurationsscreen für den Intervall-Timer
     ════════════════════════════════════════════════════════════════ -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:titleTextColor="?attr/colorOnPrimary" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollbarer Inhalt -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="96dp"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_large">

            <!-- Hund-Label -->
            <TextView
                android:id="@+id/tvDogLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_body_large"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <!-- Wesensmerkmale-Hinweis -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCharacterHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:strokeWidth="1dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/tvCharacterHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/padding_large"
                    android:textSize="@dimen/text_small"
                    android:visibility="gone" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Schnell-Profile -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_large">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/interval_setup_header_presets"
                        android:textSize="@dimen/text_body_medium"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <Spinner
                        android:id="@+id/spinnerQuickProfile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/spinner_background" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Konfiguration -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_large">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/interval_setup_header_config"
                        android:textSize="@dimen/text_body_medium"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <!-- Aktiv-Dauer -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="@string/interval_setup_label_active"
                            android:textSize="@dimen/text_small" />
                        <TextView android:id="@+id/tvActiveValue" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="45s"
                            android:textSize="@dimen/text_small" android:textStyle="bold"
                            android:textColor="?attr/colorSecondary" />
                    </LinearLayout>
                    <SeekBar android:id="@+id/seekBarActive" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginBottom="16dp"
                        android:progressTint="?attr/colorSecondary" android:thumbTint="?attr/colorSecondary" />

                    <!-- Pause-Dauer -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="@string/interval_setup_label_rest"
                            android:textSize="@dimen/text_small" />
                        <TextView android:id="@+id/tvRestValue" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="30s"
                            android:textSize="@dimen/text_small" android:textStyle="bold"
                            android:textColor="?attr/colorSecondary" />
                    </LinearLayout>
                    <SeekBar android:id="@+id/seekBarRest" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginBottom="16dp"
                        android:progressTint="?attr/colorSecondary" android:thumbTint="?attr/colorSecondary" />

                    <!-- Runden -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="@string/interval_setup_label_rounds"
                            android:textSize="@dimen/text_small" />
                        <TextView android:id="@+id/tvRoundsValue" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="6"
                            android:textSize="@dimen/text_small" android:textStyle="bold"
                            android:textColor="?attr/colorSecondary" />
                    </LinearLayout>
                    <SeekBar android:id="@+id/seekBarRounds" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginBottom="16dp"
                        android:progressTint="?attr/colorSecondary" android:thumbTint="?attr/colorSecondary" />

                    <!-- Abkühlphase -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="@string/interval_setup_label_cooldown"
                            android:textSize="@dimen/text_small" />
                        <TextView android:id="@+id/tvCooldownValue" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="60s"
                            android:textSize="@dimen/text_small" android:textStyle="bold"
                            android:textColor="?attr/colorSecondary" />
                    </LinearLayout>
                    <SeekBar android:id="@+id/seekBarCooldown" android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:progressTint="?attr/colorSecondary" android:thumbTint="?attr/colorSecondary" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Ton & Vibration -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="@dimen/padding_large">

                    <!-- Sound -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="@string/interval_setup_label_sound"
                            android:textSize="@dimen/text_small" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchSound" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:checked="true" />
                    </LinearLayout>

                    <!-- Vibration -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="@string/interval_setup_label_vibration"
                            android:textSize="@dimen/text_small" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchVibration" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:checked="true" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Gesamtdauer -->
            <TextView
                android:id="@+id/tvTotalDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/interval_setup_total_duration"
                android:textSize="@dimen/text_body_large"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <!-- ════════════════════════════════════════════════════
                 ERKLÄRUNGSBOX – So funktioniert der Intervall-Timer
                 ════════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardExplanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:strokeWidth="1dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_large">

                    <!-- Titel -->
                    <TextView
                        android:id="@+id/tvExplanationTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/interval_setup_header_info"
                        android:textSize="@dimen/text_body_medium"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <!-- Ablauf -->
                    <TextView
                        android:id="@+id/tvAblaufTitel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/interval_setup_info_sequence_title"
                        android:textSize="@dimen/text_small"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvAblaufInhalt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_small"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="12dp"
                        android:text="@string/interval_setup_info_sequence_desc" />

                    <!-- Warum Intervalle -->
                    <TextView
                        android:id="@+id/tvWarumTitel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/interval_setup_info_why_title"
                        android:textSize="@dimen/text_small"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvWarumInhalt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_small"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="12dp"
                        android:text="@string/interval_setup_info_why_desc" />

                    <!-- Ton & Vibration Erklärung -->
                    <TextView
                        android:id="@+id/tvSignaleTitel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/interval_setup_info_signals_title"
                        android:textSize="@dimen/text_small"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvSignaleInhalt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_small"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/interval_setup_info_signals_desc" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Start-Button (fixiert am unteren Rand) im neuen Grid-Stil -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/gridStartTimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="8dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="1" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
