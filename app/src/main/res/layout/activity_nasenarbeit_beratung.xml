<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/gl_bar"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"/>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Single child with behavior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Progress bar -->
        <LinearLayout
            android:id="@+id/layoutProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">
            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:max="6"
                android:progress="1"
                android:layout_marginBottom="4dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/nasenarbeit_beratung_tab_wetter" android:textSize="9sp" android:textAlignment="center"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/nasenarbeit_beratung_tab_gelaende" android:textSize="9sp" android:textAlignment="center"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/nasenarbeit_beratung_tab_boden" android:textSize="9sp" android:textAlignment="center"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/nasenarbeit_beratung_tab_training" android:textSize="9sp" android:textAlignment="center"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/nasenarbeit_beratung_tab_empfehlung" android:textSize="9sp" android:textAlignment="center"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Screen container -->
        <FrameLayout
            android:id="@+id/screenContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- S1: LADEN -->
            <LinearLayout
                android:id="@+id/screenLoading"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp">
                <ProgressBar
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginBottom="20dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nasenarbeit_beratung_loading_title"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nasenarbeit_beratung_loading_desc"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- S2: WETTER (Schicht 1) -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/screenWetter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/nasenarbeit_beratung_wetter_header"
                        android:textSize="10sp" android:textAllCaps="true" android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <!-- Wetter Karte -->
                    <com.hundewildnis.app.GlassCardView
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp" app:cardCornerRadius="12dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:padding="16dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/nasenarbeit_beratung_wetter_current" android:textSize="13sp" android:textStyle="bold"
                                android:layout_marginBottom="12dp"/>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                                    <TextView android:id="@+id/tvWetterIcon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="36sp" android:text="..."/>
                                    <TextView android:id="@+id/tvWetterLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textAlignment="center"/>
                                </LinearLayout>
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:orientation="vertical">
                                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
                                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/nasenarbeit_beratung_wetter_temp" android:textSize="12sp"/>
                                        <TextView android:id="@+id/tvTemp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold"/>
                                    </LinearLayout>
                                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
                                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/nasenarbeit_beratung_wetter_beaufort" android:textSize="12sp"/>
                                        <TextView android:id="@+id/tvBeaufort" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold"/>
                                    </LinearLayout>
                                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/nasenarbeit_beratung_wetter_humidity" android:textSize="12sp"/>
                                        <TextView android:id="@+id/tvHumidity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold"/>
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </com.hundewildnis.app.GlassCardView>

                    <!-- Harter Ausschluss -->
                    <com.hundewildnis.app.GlassCardView
                        android:id="@+id/cardExclusion"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp" app:cardCornerRadius="12dp"
                        app:strokeColor="@color/gl_danger_stroke" app:strokeWidth="2dp" android:visibility="gone">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:padding="16dp" android:gravity="center">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nasenarbeit_beratung_exclusion_title" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/gl_danger" android:layout_marginBottom="6dp"/>
                            <TextView android:id="@+id/tvExclusionReason" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textAlignment="center"/>
                        </LinearLayout>
                    </com.hundewildnis.app.GlassCardView>

                    <!-- Disziplin-Eignung Wetter -->
                    <LinearLayout android:id="@+id/layoutWetterEignung"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:layout_marginBottom="12dp"
                        android:visibility="gone">
                        <com.hundewildnis.app.GlassCardView
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            app:cardCornerRadius="12dp">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:orientation="vertical" android:padding="14dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="@string/nasenarbeit_beratung_suitability_header" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="10dp"/>
                                <LinearLayout android:id="@+id/layoutWetterBadges" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
                            </LinearLayout>
                        </com.hundewildnis.app.GlassCardView>
                    </LinearLayout>

                    <!-- Windrichtung -->
                    <com.hundewildnis.app.GlassCardView
                        android:id="@+id/cardWindDir"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp" app:cardCornerRadius="12dp"
                        android:visibility="gone">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:padding="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/nasenarbeit_beratung_wind_title"
                                android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:text="@string/nasenarbeit_beratung_wind_desc"
                                android:textSize="12sp" android:layout_marginBottom="10dp"/>
                            <RadioGroup android:id="@+id/rgWindDir" android:layout_width="match_parent" android:layout_height="wrap_content">
                                <RadioButton android:id="@+id/rbWindHinten" android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:text="@string/nasenarbeit_beratung_wind_tailwind"
                                    android:textSize="12sp" android:padding="8dp" android:checked="true"/>
                                <RadioButton android:id="@+id/rbWindSeite" android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:text="@string/nasenarbeit_beratung_wind_crosswind"
                                    android:textSize="12sp" android:padding="8dp"/>
                                <RadioButton android:id="@+id/rbWindVorn" android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:text="@string/nasenarbeit_beratung_wind_headwind"
                                    android:textSize="12sp" android:padding="8dp"/>
                            </RadioGroup>
                            <LinearLayout android:id="@+id/layoutWindDirBadges" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp"/>
                        </LinearLayout>
                    </com.hundewildnis.app.GlassCardView>

                    <com.hundewildnis.app.GlassButton
                        android:id="@+id/btnWetterWeiter"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/nasenarbeit_beratung_btn_wetter_next"
                        android:minHeight="52dp" app:cornerRadius="10dp" android:enabled="false" style="@style/Widget.App.Button"/>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- S3: GELÄNDE (Schicht 2) -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/screenGelande"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/nasenarbeit_beratung_gelaende_header"
                        android:textSize="10sp" android:textAllCaps="true" android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <!-- Topografie -->
                    <com.hundewildnis.app.GlassCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="12dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nasenarbeit_beratung_topo_title" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nasenarbeit_beratung_topo_desc" android:textSize="11sp" android:layout_marginBottom="8dp"/>
                            <com.google.android.material.chip.ChipGroup android:id="@+id/chipGroupTopoSel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" app:chipSpacingVertical="4dp"/>
                            <com.google.android.material.chip.ChipGroup android:id="@+id/chipGroupTopoOpts" android:layout_width="match_parent" android:layout_height="wrap_content" app:chipSpacingVertical="4dp"/>
                        </LinearLayout>
                    </com.hundewildnis.app.GlassCardView>

                    <!-- Umgebung -->
                    <com.hundewildnis.app.GlassCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="12dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nasenarbeit_beratung_umb_title" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nasenarbeit_beratung_umb_desc" android:textSize="11sp" android:layout_marginBottom="8dp"/>
                            <com.google.android.material.chip.ChipGroup android:id="@+id/chipGroupUmbSel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" app:chipSpacingVertical="4dp"/>
                            <com.google.android.material.chip.ChipGroup android:id="@+id/chipGroupUmbOpts" android:layout_width="match_parent" android:layout_height="wrap_content" app:chipSpacingVertical="4dp"/>
                        </LinearLayout>
                    </com.hundewildnis.app.GlassCardView>

                    <!-- Trainingsgebiet -->
                    <com.hundewildnis.app.GlassCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="12dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nasenarbeit_beratung_gebiet_title" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/nasenarbeit_beratung_gebiet_steps_label" android:textSize="12sp"/>
                                <TextView android:id="@+id/tvGebietSchritte" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="500" android:textSize="14sp" android:textStyle="bold"/>
                            </LinearLayout>
                            <SeekBar android:id="@+id/sbGebietSchritte" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="59" android:progress="9" android:layout_marginBottom="12dp"/>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/nasenarbeit_beratung_gebiet_area_label" android:textSize="12sp"/>
                                <TextView android:id="@+id/tvGebietHa" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.5 ha" android:textSize="14sp" android:textStyle="bold"/>
                            </LinearLayout>
                            <SeekBar android:id="@+id/sbGebietHa" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="99" android:progress="4" android:layout_marginBottom="8dp"/>
                            <TextView android:id="@+id/tvGebietHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp"/>
                        </LinearLayout>
                    </com.hundewildnis.app.GlassCardView>

                    <LinearLayout android:id="@+id/layoutGelaendeEignung" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp"/>

                    <com.hundewildnis.app.GlassButton
                        android:id="@+id/btnGelaendeWeiter"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/nasenarbeit_beratung_btn_gelaende_next"
                        android:minHeight="52dp" app:cornerRadius="10dp" style="@style/Widget.App.Button"/>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- S4: BODEN (Schicht 3) – dynamisch befüllt -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/screenBoden"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/nasenarbeit_beratung_boden_header"
                        android:textSize="10sp" android:textAllCaps="true" android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <com.hundewildnis.app.GlassCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="10dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/nasenarbeit_beratung_boden_desc"
                            android:textSize="12sp" android:padding="12dp"/>
                    </com.hundewildnis.app.GlassCardView>

                    <!-- Dynamische Boden-Einträge -->
                    <LinearLayout android:id="@+id/layoutBodenEntries"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical"/>

                    <com.hundewildnis.app.GlassButton
                        android:id="@+id/btnBodenWeiter"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/nasenarbeit_beratung_btn_boden_next"
                        android:minHeight="52dp" app:cornerRadius="10dp"
                        android:enabled="false" android:layout_marginTop="8dp" style="@style/Widget.App.Button"/>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- S5: TRAININGSSTAND (Schicht 4) -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/screenTraining"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/nasenarbeit_beratung_training_header"
                        android:textSize="10sp" android:textAllCaps="true" android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <!-- Level -->
                    <com.hundewildnis.app.GlassCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="12dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nasenarbeit_beratung_level_title" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="10dp"/>
                            <LinearLayout android:id="@+id/layoutLevelDisplay" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
                        </LinearLayout>
                    </com.hundewildnis.app.GlassCardView>

                    <!-- Letzte Einheit -->
                    <com.hundewildnis.app.GlassCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="12dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nasenarbeit_beratung_last_session_title" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
                            <RadioGroup android:id="@+id/rgLetzte" android:layout_width="match_parent" android:layout_height="wrap_content">
                                <RadioButton android:id="@+id/rbGestern" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nasenarbeit_beratung_last_yesterday" android:textSize="13sp" android:padding="6dp" android:checked="true"/>
                                <RadioButton android:id="@+id/rbHeute" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nasenarbeit_beratung_last_today" android:textSize="13sp" android:padding="6dp"/>
                                <RadioButton android:id="@+id/rb7Tage" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nasenarbeit_beratung_last_7days" android:textSize="13sp" android:padding="6dp"/>
                                <RadioButton android:id="@+id/rb14Tage" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nasenarbeit_beratung_last_14days" android:textSize="13sp" android:padding="6dp"/>
                                <RadioButton android:id="@+id/rbNochKeine" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nasenarbeit_beratung_last_none" android:textSize="13sp" android:padding="6dp"/>
                            </RadioGroup>
                        </LinearLayout>
                    </com.hundewildnis.app.GlassCardView>

                    <!-- Tagesverfassung -->
                    <com.hundewildnis.app.GlassCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="12dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nasenarbeit_beratung_condition_title" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
                            <RadioGroup android:id="@+id/rgVerfassung" android:layout_width="match_parent" android:layout_height="wrap_content">
                                <RadioButton android:id="@+id/rbNormal" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nasenarbeit_beratung_condition_normal" android:textSize="13sp" android:padding="6dp" android:checked="true"/>
                                <RadioButton android:id="@+id/rbSehr" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nasenarbeit_beratung_condition_very" android:textSize="13sp" android:padding="6dp"/>
                                <RadioButton android:id="@+id/rbExtrem" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nasenarbeit_beratung_condition_extreme" android:textSize="13sp" android:padding="6dp"/>
                            </RadioGroup>
                        </LinearLayout>
                    </com.hundewildnis.app.GlassCardView>

                    <!-- Leistungsdaten -->
                    <com.hundewildnis.app.GlassCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="12dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nasenarbeit_beratung_performance_title" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="10dp"/>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/nasenarbeit_beratung_perf_v_label" android:textSize="12sp"/>
                                <TextView android:id="@+id/tvPerfV" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold"/>
                            </LinearLayout>
                            <SeekBar android:id="@+id/sbPerfV" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="200" android:progress="31" android:layout_marginBottom="10dp"/>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/nasenarbeit_beratung_perf_p_label" android:textSize="12sp"/>
                                <TextView android:id="@+id/tvPerfP" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold"/>
                            </LinearLayout>
                            <SeekBar android:id="@+id/sbPerfP" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="200" android:progress="28" android:layout_marginBottom="10dp"/>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/nasenarbeit_beratung_perf_f_label" android:textSize="12sp"/>
                                <TextView android:id="@+id/tvPerfFl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold"/>
                            </LinearLayout>
                            <SeekBar android:id="@+id/sbPerfFl" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="50" android:progress="4"/>
                        </LinearLayout>
                    </com.hundewildnis.app.GlassCardView>

                    <com.hundewildnis.app.GlassButton
                        android:id="@+id/btnTrainingWeiter"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/nasenarbeit_beratung_btn_training_next"
                        android:minHeight="52dp" app:cornerRadius="10dp" style="@style/Widget.App.Button"/>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- S6: EMPFEHLUNG -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/screenEmpfehlung"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/nasenarbeit_beratung_empfehlung_header"
                        android:textSize="10sp" android:textAllCaps="true" android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <!-- Block 1: Empfehlung -->
                    <com.hundewildnis.app.GlassCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" app:cardCornerRadius="12dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nasenarbeit_beratung_block1_title" android:textSize="11sp" android:textStyle="bold" android:textAllCaps="true" android:padding="12dp" android:background="@color/gl_divider"/>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                                <TextView android:id="@+id/tvEmpfehlungDiz" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="22sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                                <TextView android:id="@+id/tvEmpfehlungAlt" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:layout_marginBottom="6dp" android:visibility="gone"/>
                                <TextView android:id="@+id/tvEmpfehlungScore" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:fontFamily="monospace" android:layout_marginBottom="6dp"/>
                                <TextView android:id="@+id/tvEmpfehlungGrund" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp"/>
                            </LinearLayout>
                        </LinearLayout>
                    </com.hundewildnis.app.GlassCardView>

                    <!-- Block 2: Parameter -->
                    <com.hundewildnis.app.GlassCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" app:cardCornerRadius="12dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nasenarbeit_beratung_block2_title" android:textSize="11sp" android:textStyle="bold" android:textAllCaps="true" android:padding="12dp" android:background="@color/gl_divider"/>
                            <LinearLayout android:id="@+id/layoutParamGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp"/>
                        </LinearLayout>
                    </com.hundewildnis.app.GlassCardView>

                    <!-- Block 3: Vorbereitung -->
                    <com.hundewildnis.app.GlassCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" app:cardCornerRadius="12dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nasenarbeit_beratung_block3_title" android:textSize="11sp" android:textStyle="bold" android:textAllCaps="true" android:padding="12dp" android:background="@color/gl_divider"/>
                            <LinearLayout android:id="@+id/layoutVorbereitung" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp"/>
                        </LinearLayout>
                    </com.hundewildnis.app.GlassCardView>

                    <!-- Block 5: Während -->
                    <com.hundewildnis.app.GlassCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" app:cardCornerRadius="12dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nasenarbeit_beratung_block5_title" android:textSize="11sp" android:textStyle="bold" android:textAllCaps="true" android:padding="12dp" android:background="@color/gl_divider"/>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                                <!-- Tab Buttons -->
                                <com.google.android.material.tabs.TabLayout
                                    android:id="@+id/tabLayoutB5"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="12dp"
                                    app:tabMode="fixed"
                                    app:tabGravity="fill"
                                    app:tabIndicatorHeight="2dp"
                                    app:tabTextAppearance="@style/TextAppearance.MaterialComponents.Caption"
                                    app:tabSelectedTextColor="?attr/colorSecondary"
                                    app:tabIconTint="?attr/colorSecondary"
                                    app:tabRippleColor="@null">
                                    <com.google.android.material.tabs.TabItem
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/nasenarbeit_beratung_tab_success"
                                        android:icon="@drawable/ic_check_circle"/>
                                    <com.google.android.material.tabs.TabItem
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/nasenarbeit_beratung_tab_warnings"
                                        android:icon="@drawable/ic_info"/>
                                    <com.google.android.material.tabs.TabItem
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/nasenarbeit_beratung_tab_abort"
                                        android:icon="@android:drawable/ic_menu_close_clear_cancel"/>
                                    <com.google.android.material.tabs.TabItem
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/nasenarbeit_beratung_tab_weather"
                                        android:icon="@drawable/ic_refresh"/>
                                </com.google.android.material.tabs.TabLayout>
                                <LinearLayout android:id="@+id/layoutB5Content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
                            </LinearLayout>
                        </LinearLayout>
                    </com.hundewildnis.app.GlassCardView>

                    <!-- Block 6: Nach dem Training -->
                    <com.hundewildnis.app.GlassCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardCornerRadius="12dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nasenarbeit_beratung_block6_title" android:textSize="11sp" android:textStyle="bold" android:textAllCaps="true" android:padding="12dp" android:background="@color/gl_divider"/>
                            <LinearLayout android:id="@+id/layoutNachTraining" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp"/>
                        </LinearLayout>
                    </com.hundewildnis.app.GlassCardView>

                    <com.hundewildnis.app.GlassButton
                        android:id="@+id/btnTrainingStarten"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/nasenarbeit_beratung_btn_start_training"
                        android:minHeight="56dp" app:cornerRadius="10dp" android:layout_marginBottom="8dp" style="@style/Widget.App.Button"/>

                    <com.hundewildnis.app.GlassButton
                        android:id="@+id/btnNeueBeratung"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/nasenarbeit_beratung_btn_new_beratung"
                        android:minHeight="48dp" style="@style/Widget.App.Button.Outlined"
                        app:cornerRadius="10dp"/>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

        </FrameLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>