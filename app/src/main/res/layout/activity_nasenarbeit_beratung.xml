<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"/>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Single child with behavior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Progress bar -->
        <LinearLayout
            android:id="@+id/layoutProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:background="?attr/colorSurface">
            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:max="6"
                android:progress="1"
                android:layout_marginBottom="4dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Wetter" android:textSize="9sp" android:textAlignment="center"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Gelände" android:textSize="9sp" android:textAlignment="center"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Boden" android:textSize="9sp" android:textAlignment="center"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Training" android:textSize="9sp" android:textAlignment="center"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Empfehlung" android:textSize="9sp" android:textAlignment="center"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Screen container -->
        <FrameLayout
            android:id="@+id/screenContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- S1: LADEN -->
            <LinearLayout
                android:id="@+id/screenLoading"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp">
                <ProgressBar
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginBottom="20dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GPS &amp; Wetterdaten werden abgerufen"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open-Meteo API · Automatisch"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- S2: WETTER (Schicht 1) -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/screenWetter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Schicht 1 · Wetterbedingungen"
                        android:textSize="10sp" android:textAllCaps="true" android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <!-- Wetter Karte -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp" app:cardCornerRadius="12dp" app:cardElevation="2dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:padding="16dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Aktuelle Wetterdaten" android:textSize="13sp" android:textStyle="bold"
                                android:layout_marginBottom="12dp"/>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                                    <TextView android:id="@+id/tvWetterIcon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="36sp" android:text="..."/>
                                    <TextView android:id="@+id/tvWetterLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textAlignment="center"/>
                                </LinearLayout>
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:orientation="vertical">
                                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
                                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Temperatur" android:textSize="12sp"/>
                                        <TextView android:id="@+id/tvTemp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold"/>
                                    </LinearLayout>
                                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
                                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Beaufort" android:textSize="12sp"/>
                                        <TextView android:id="@+id/tvBeaufort" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold"/>
                                    </LinearLayout>
                                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Luftfeuchte" android:textSize="12sp"/>
                                        <TextView android:id="@+id/tvHumidity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold"/>
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Harter Ausschluss -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardExclusion"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp" app:cardCornerRadius="12dp"
                        app:strokeColor="#f87171" app:strokeWidth="2dp" android:visibility="gone">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:padding="16dp" android:gravity="center">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Training heute nicht möglich" android:textSize="15sp" android:textStyle="bold" android:textColor="#f87171" android:layout_marginBottom="6dp"/>
                            <TextView android:id="@+id/tvExclusionReason" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textAlignment="center"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Disziplin-Eignung Wetter -->
                    <LinearLayout android:id="@+id/layoutWetterEignung"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:layout_marginBottom="12dp"
                        android:visibility="gone">
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            app:cardCornerRadius="12dp" app:cardElevation="2dp">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:orientation="vertical" android:padding="14dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Disziplin-Eignung Wetter" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="10dp"/>
                                <LinearLayout android:id="@+id/layoutWetterBadges" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- Windrichtung -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardWindDir"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp" app:cardCornerRadius="12dp" app:cardElevation="2dp"
                        android:visibility="gone">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:padding="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Windrichtung in Bodennähe (bis 1m)"
                                android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:text="Vorherrschende Richtung in Bezug auf das Gelände ab Startpunkt:"
                                android:textSize="12sp" android:layout_marginBottom="10dp"/>
                            <RadioGroup android:id="@+id/rgWindDir" android:layout_width="match_parent" android:layout_height="wrap_content">
                                <RadioButton android:id="@+id/rbWindHinten" android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:text="Rückenwind – Fährte: alle Level · Personensuche + Freisuche: ab Fortgeschritten"
                                    android:textSize="12sp" android:padding="8dp" android:checked="true"/>
                                <RadioButton android:id="@+id/rbWindSeite" android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:text="Seitenwind – Alle Disziplinen: ab Fortgeschritten"
                                    android:textSize="12sp" android:padding="8dp"/>
                                <RadioButton android:id="@+id/rbWindVorn" android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:text="Gegenwind – Verlorensuche: ab Erfahren · Personensuche + Freisuche: ab Anfänger"
                                    android:textSize="12sp" android:padding="8dp"/>
                            </RadioGroup>
                            <LinearLayout android:id="@+id/layoutWindDirBadges" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWetterWeiter"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Weiter zu Geländemerkmalen →"
                        android:minHeight="52dp" app:cornerRadius="10dp" android:enabled="false"/>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- S3: GELÄNDE (Schicht 2) -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/screenGelande"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Schicht 2 · Geländemerkmale"
                        android:textSize="10sp" android:textAllCaps="true" android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <!-- Topografie -->
                    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="12dp" app:cardElevation="2dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Topografie – Routenreihenfolge" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tippe in der Reihenfolge, wie das Gelände auf der Route vorkommt" android:textSize="11sp" android:layout_marginBottom="8dp"/>
                            <com.google.android.material.chip.ChipGroup android:id="@+id/chipGroupTopoSel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" app:chipSpacingVertical="4dp"/>
                            <com.google.android.material.chip.ChipGroup android:id="@+id/chipGroupTopoOpts" android:layout_width="match_parent" android:layout_height="wrap_content" app:chipSpacingVertical="4dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Umgebung -->
                    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="12dp" app:cardElevation="2dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Umgebung – Routenreihenfolge" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tippe in der Reihenfolge, wie die Umgebung auf der Route vorkommt" android:textSize="11sp" android:layout_marginBottom="8dp"/>
                            <com.google.android.material.chip.ChipGroup android:id="@+id/chipGroupUmbSel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" app:chipSpacingVertical="4dp"/>
                            <com.google.android.material.chip.ChipGroup android:id="@+id/chipGroupUmbOpts" android:layout_width="match_parent" android:layout_height="wrap_content" app:chipSpacingVertical="4dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Trainingsgebiet -->
                    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="12dp" app:cardElevation="2dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Verfügbares Trainingsgebiet" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Max. Schritte (Verloren- + Personensuche)" android:textSize="12sp"/>
                                <TextView android:id="@+id/tvGebietSchritte" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="500" android:textSize="14sp" android:textStyle="bold"/>
                            </LinearLayout>
                            <SeekBar android:id="@+id/sbGebietSchritte" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="59" android:progress="9" android:layout_marginBottom="12dp"/>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Verfügbare Fläche (Freisuche)" android:textSize="12sp"/>
                                <TextView android:id="@+id/tvGebietHa" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.5 ha" android:textSize="14sp" android:textStyle="bold"/>
                            </LinearLayout>
                            <SeekBar android:id="@+id/sbGebietHa" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="99" android:progress="4" android:layout_marginBottom="8dp"/>
                            <TextView android:id="@+id/tvGebietHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout android:id="@+id/layoutGelaendeEignung" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGelaendeWeiter"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Weiter zu Bodenbedingungen →"
                        android:minHeight="52dp" app:cornerRadius="10dp"/>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- S4: BODEN (Schicht 3) – dynamisch befüllt -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/screenBoden"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Schicht 3 · Bodenbedingungen"
                        android:textSize="10sp" android:textAllCaps="true" android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="10dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="Basierend auf deiner Geländesequenz – wähle pro Abschnitt Bodentyp und Zustand.\nScoring: Schwellwert 33% · Mehrheitswert gewichtet · Proportional nach Länge"
                            android:textSize="12sp" android:padding="12dp"/>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Dynamische Boden-Einträge -->
                    <LinearLayout android:id="@+id/layoutBodenEntries"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBodenWeiter"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Weiter zum Trainingsstand →"
                        android:minHeight="52dp" app:cornerRadius="10dp"
                        android:enabled="false" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- S5: TRAININGSSTAND (Schicht 4) -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/screenTraining"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Schicht 4 · Trainingsstand"
                        android:textSize="10sp" android:textAllCaps="true" android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <!-- Level -->
                    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="12dp" app:cardElevation="2dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trainingslevel – automatisch aus Tagebuch" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="10dp"/>
                            <LinearLayout android:id="@+id/layoutLevelDisplay" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Letzte Einheit -->
                    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="12dp" app:cardElevation="2dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Letzte Trainingseinheit" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
                            <RadioGroup android:id="@+id/rgLetzte" android:layout_width="match_parent" android:layout_height="wrap_content">
                                <RadioButton android:id="@+id/rbGestern" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Gestern  (Normwert +)" android:textSize="13sp" android:padding="6dp" android:checked="true"/>
                                <RadioButton android:id="@+id/rbHeute" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Heute  (Kürzer)" android:textSize="13sp" android:padding="6dp"/>
                                <RadioButton android:id="@+id/rb7Tage" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Innerhalb 7 Tage  (Normwert)" android:textSize="13sp" android:padding="6dp"/>
                                <RadioButton android:id="@+id/rb14Tage" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Innerhalb 14 Tage  (Aufwärm)" android:textSize="13sp" android:padding="6dp"/>
                                <RadioButton android:id="@+id/rbNochKeine" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Noch keine Trainingseinheit  (Startwerte)" android:textSize="13sp" android:padding="6dp"/>
                            </RadioGroup>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Tagesverfassung -->
                    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="12dp" app:cardElevation="2dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tagesverfassung Hund" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
                            <RadioGroup android:id="@+id/rgVerfassung" android:layout_width="match_parent" android:layout_height="wrap_content">
                                <RadioButton android:id="@+id/rbNormal" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Normal motiviert  (Normwert +)" android:textSize="13sp" android:padding="6dp" android:checked="true"/>
                                <RadioButton android:id="@+id/rbSehr" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sehr motiviert  (+1 Stufe)" android:textSize="13sp" android:padding="6dp"/>
                                <RadioButton android:id="@+id/rbExtrem" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Extrem motiviert  (+ Länge)" android:textSize="13sp" android:padding="6dp"/>
                            </RadioGroup>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Leistungsdaten -->
                    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="12dp" app:cardElevation="2dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Letzte Leistungsdaten" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="10dp"/>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Verlorensuche (Schritte)" android:textSize="12sp"/>
                                <TextView android:id="@+id/tvPerfV" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold"/>
                            </LinearLayout>
                            <SeekBar android:id="@+id/sbPerfV" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="200" android:progress="31" android:layout_marginBottom="10dp"/>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Personensuche (Schritte)" android:textSize="12sp"/>
                                <TextView android:id="@+id/tvPerfP" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold"/>
                            </LinearLayout>
                            <SeekBar android:id="@+id/sbPerfP" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="200" android:progress="28" android:layout_marginBottom="10dp"/>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Freisuche (ha)" android:textSize="12sp"/>
                                <TextView android:id="@+id/tvPerfFl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold"/>
                            </LinearLayout>
                            <SeekBar android:id="@+id/sbPerfFl" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="50" android:progress="4"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTrainingWeiter"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Trainingsempfehlung erstellen →"
                        android:minHeight="52dp" app:cornerRadius="10dp"/>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- S6: EMPFEHLUNG -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/screenEmpfehlung"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Trainingsanleitung für heute"
                        android:textSize="10sp" android:textAllCaps="true" android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <!-- Block 1: Empfehlung -->
                    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" app:cardCornerRadius="12dp" app:cardElevation="2dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Block 1 · Empfehlung" android:textSize="11sp" android:textStyle="bold" android:textAllCaps="true" android:padding="12dp" android:background="?attr/colorSurfaceVariant"/>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                                <TextView android:id="@+id/tvEmpfehlungDiz" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="22sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                                <TextView android:id="@+id/tvEmpfehlungAlt" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:layout_marginBottom="6dp" android:visibility="gone"/>
                                <TextView android:id="@+id/tvEmpfehlungScore" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:fontFamily="monospace" android:layout_marginBottom="6dp"/>
                                <TextView android:id="@+id/tvEmpfehlungGrund" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp"/>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Block 2: Parameter -->
                    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" app:cardCornerRadius="12dp" app:cardElevation="2dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Block 2 · Heutige Trainingsparameter" android:textSize="11sp" android:textStyle="bold" android:textAllCaps="true" android:padding="12dp" android:background="?attr/colorSurfaceVariant"/>
                            <LinearLayout android:id="@+id/layoutParamGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Block 3: Vorbereitung -->
                    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" app:cardCornerRadius="12dp" app:cardElevation="2dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Block 3 · Vorbereitung" android:textSize="11sp" android:textStyle="bold" android:textAllCaps="true" android:padding="12dp" android:background="?attr/colorSurfaceVariant"/>
                            <LinearLayout android:id="@+id/layoutVorbereitung" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Block 5: Während -->
                    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" app:cardCornerRadius="12dp" app:cardElevation="2dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Block 5 · Während des Trainings" android:textSize="11sp" android:textStyle="bold" android:textAllCaps="true" android:padding="12dp" android:background="?attr/colorSurfaceVariant"/>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                                <!-- Tab Buttons -->
                                <com.google.android.material.tabs.TabLayout
                                    android:id="@+id/tabLayoutB5"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="12dp"
                                    app:tabMode="fixed"
                                    app:tabGravity="fill"
                                    app:tabIndicatorHeight="2dp"
                                    app:tabTextAppearance="@style/TextAppearance.MaterialComponents.Caption"
                                    app:tabSelectedTextColor="?attr/colorPrimary"
                                    app:tabIconTint="?attr/colorPrimary"
                                    app:tabRippleColor="@null">
                                    <com.google.android.material.tabs.TabItem
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Erfolg"
                                        android:icon="@drawable/ic_check_circle"/>
                                    <com.google.android.material.tabs.TabItem
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Warn."
                                        android:icon="@drawable/ic_signal"/>
                                    <com.google.android.material.tabs.TabItem
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Abbruch"
                                        android:icon="@android:drawable/ic_menu_close_clear_cancel"/>
                                    <com.google.android.material.tabs.TabItem
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Wetter"
                                        android:icon="@drawable/ic_refresh"/>
                                </com.google.android.material.tabs.TabLayout>
                                <LinearLayout android:id="@+id/layoutB5Content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Block 6: Nach dem Training -->
                    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardCornerRadius="12dp" app:cardElevation="2dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Block 6 · Nach dem Training" android:textSize="11sp" android:textStyle="bold" android:textAllCaps="true" android:padding="12dp" android:background="?attr/colorSurfaceVariant"/>
                            <LinearLayout android:id="@+id/layoutNachTraining" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTrainingStarten"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Training starten &amp; Ergebnis erfassen"
                        android:minHeight="56dp" app:cornerRadius="10dp" android:layout_marginBottom="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNeueBeratung"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Neue Beratung starten"
                        android:minHeight="48dp" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        app:cornerRadius="10dp"/>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

        </FrameLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>