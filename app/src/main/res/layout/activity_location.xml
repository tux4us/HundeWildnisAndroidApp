<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a1a">

    <!-- ════════════════════════════════════════════════════════════ -->
    <!-- TOOLBAR -->
    <!-- ════════════════════════════════════════════════════════════ -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#2d5016"
            app:titleTextColor="#FFFFFF"
            app:navigationIcon="?attr/homeAsUpIndicator" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ════════════════════════════════════════════════════════════ -->
    <!-- POI SUCHFELD - UNTER TOOLBAR -->
    <!-- ════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutPOISearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="?android:attr/windowBackground"
        android:elevation="4dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <EditText
            android:id="@+id/etPOISearch"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="🔍 POI suchen (z.B. Bahnhof)"
            android:textSize="14sp"
            android:paddingStart="12dp"
            android:paddingEnd="10dp"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:textColor="@color/search_field_text"
            android:textColorHint="@color/search_field_hint"
            android:background="@drawable/bg_search_field"
            android:drawableTint="@color/search_field_text"
            android:maxLines="1"
            android:drawableEnd="@android:drawable/ic_menu_close_clear_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSearchPOI"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="🔍"
            android:textSize="20sp"
            app:backgroundTint="#2d5016"
            app:cornerRadius="24dp" />

        <ProgressBar
            android:id="@+id/progressSearch"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ════════════════════════════════════════════════════════════ -->
    <!-- MAIN CONTENT - KARTE + BOTTOM CARD -->
    <!-- ════════════════════════════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="72dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Map container -->
        <FrameLayout
            android:id="@+id/mapFrame"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/bottomCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <org.osmdroid.views.MapView
                android:id="@+id/mapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/osmCopyrightText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="4dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="#CC000000"
                android:text="Map data © OpenStreetMap Contributors"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="16dp"
                android:orientation="vertical"
                android:background="@drawable/button_bg_rounded"
                android:elevation="4dp">

                <Button
                    android:id="@+id/btnCurrentLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 Standort"
                    android:textSize="12sp"
                    android:padding="8dp"
                    android:background="@drawable/poi_button_bg"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="8dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />

                <Button
                    android:id="@+id/shareButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📤 Teilen"
                    android:textSize="12sp"
                    android:padding="8dp"
                    android:background="@drawable/poi_button_bg"
                    android:textColor="#FFFFFF"
                    android:enabled="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/coordinatesText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="16dp"
                android:text="📍 Standort wird ermittelt..."
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:background="#80000000"
                android:padding="6dp"
                android:elevation="4dp" />

            <TextView
                android:id="@+id/navigationInfoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="60dp"
                android:text="🧭 0.0 km • 0 Min"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:background="#DD2d5016"
                android:padding="14dp"
                android:elevation="12dp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="#8fad6f"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Bottom Card mit Kategorien ODER POI-Liste -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bottomCard"
            android:layout_width="0dp"
            android:layout_height="340dp"
            app:cardBackgroundColor="#2d2d2d"
            app:cardElevation="8dp"
            app:cardCornerRadius="16dp"
            android:layout_margin="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- ═══════════════════════════════════════════ -->
                <!-- KATEGORIEN-ANSICHT (initial sichtbar) -->
                <!-- ═══════════════════════════════════════════ -->
                <LinearLayout
                    android:id="@+id/categoryView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <!-- Header -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📍 POI Kategorien wählen"
                        android:textColor="#8fad6f"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:padding="16dp"
                        android:textAlignment="center"
                        android:background="#3d3d3d" />

                    <!-- Kategorien-Grid (scrollbar) -->
                    <androidx.core.widget.NestedScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fillViewport="true">

                        <GridLayout
                            android:id="@+id/categoryGrid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:columnCount="3"
                            android:rowCount="6"
                            android:padding="12dp"
                            android:alignmentMode="alignBounds"
                            android:columnOrderPreserved="false"
                            android:useDefaultMargins="true" />

                    </androidx.core.widget.NestedScrollView>

                </LinearLayout>

                <!-- ═══════════════════════════════════════════ -->
                <!-- POI-LISTE (nach Kategorie-Auswahl) -->
                <!-- ═══════════════════════════════════════════ -->
                <LinearLayout
                    android:id="@+id/poiListView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Header mit Zurück-Button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:background="#3d3d3d"
                        android:gravity="center_vertical">

                        <Button
                            android:id="@+id/btnBackToCategories"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="← Zurück"
                            android:textSize="16sp"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/poi_button_bg"
                            android:padding="0dp"
                            android:layout_marginEnd="8dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/categoryTitleText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🐕 Hundeauslauf"
                                android:textColor="#8FC357"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/poiCountText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 POI in 3 km"
                                android:textColor="#999999"
                                android:textSize="12sp" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- POI Liste -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/poiRecyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="6dp"
                            android:clipToPadding="false" />

                        <ProgressBar
                            android:id="@+id/poiProgressBar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:indeterminateTint="#8fad6f"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/emptyPoiText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="Keine POI gefunden"
                            android:textColor="#666666"
                            android:textSize="13sp"
                            android:textAlignment="center"
                            android:visibility="gone" />
                    </FrameLayout>

                </LinearLayout>

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
