<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    android:background="#1a1a1a">

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- TOOLBAR                                            -->
    <!-- ═══════════════════════════════════════════════════ -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="false">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#2d5016"
            app:titleTextColor="#FFFFFF"
            app:navigationIcon="?attr/homeAsUpIndicator" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- SUCHFELD                                           -->
    <!-- ═══════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutPOISearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="?android:attr/windowBackground"
        android:elevation="4dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <EditText
            android:id="@+id/etPOISearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="🔍 Suche"
            android:textSize="@dimen/text_body_medium"
            android:paddingStart="12dp"
            android:paddingEnd="10dp"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:textColor="@color/search_field_text"
            android:textColorHint="@color/search_field_hint"
            android:background="@drawable/bg_search_field"
            android:drawableTint="@color/search_field_text"
            android:maxLines="1"/>

        <!-- NEU: Separater Clear-Button mit großer Trefferzone -->
        <ImageButton
            android:id="@+id/btnClearSearch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Suche löschen"
            android:visibility="gone"
            android:padding="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSearchPOI"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="🔍"
            android:textSize="@dimen/text_body_medium"
            app:backgroundTint="#2d5016"
            app:cornerRadius="24dp" />

        <ProgressBar
            android:id="@+id/progressSearch"
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- HAUPTINHALT: KARTE + BOTTOM-PANEL                  -->
    <!-- ═══════════════════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="72dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- ─── Karte (obere 50%) ──────────────────────── -->
        <FrameLayout
            android:id="@+id/mapFrame"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent="0.5"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <org.osmdroid.views.MapView
                android:id="@+id/mapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Copyright -->
            <TextView
                android:id="@+id/osmCopyrightText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="4dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="#CC000000"
                android:text="Map data © OpenStreetMap Contributors"
                android:textColor="#FFFFFF"
                android:textSize="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground" />

            <!-- Karten-Buttons (rechts oben) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:orientation="vertical"
                android:background="@drawable/button_bg_rounded"
                android:padding="4dp"
                android:elevation="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCurrentLocation"
                    style="@style/Widget.App.Button.Fixed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 Standort"
                    android:textSize="@dimen/text_body_small"
                    android:padding="8dp"
                    android:backgroundTint="#263316"
                    app:strokeColor="#2d5016"
                    app:strokeWidth="2dp"
                    app:cornerRadius="8dp"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="8dp"
                    android:minWidth="100dp"
                    android:minHeight="0dp"
                    app:autoSizeTextType="none" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/shareButton"
                    style="@style/Widget.App.Button.Fixed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📤 Teilen"
                    android:textSize="@dimen/text_body_small"
                    android:padding="8dp"
                    android:backgroundTint="#263316"
                    app:strokeColor="#2d5016"
                    app:strokeWidth="2dp"
                    app:cornerRadius="8dp"
                    android:textColor="#FFFFFF"
                    android:enabled="false"
                    android:minWidth="100dp"
                    android:minHeight="0dp"
                    app:autoSizeTextType="none" />
            </LinearLayout>

            <!-- Koordinaten -->
            <TextView
                android:id="@+id/coordinatesText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="16dp"
                android:text="📍 Standort wird ermittelt..."
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_body_small"
                android:background="#80000000"
                android:padding="6dp"
                android:elevation="4dp" />

            <!-- Navigation Distanz/Zeit Info -->
            <TextView
                android:id="@+id/navigationInfoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="60dp"
                android:text="🧭 0.0 km • 0 Min"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_body_medium"
                android:textStyle="bold"
                android:background="#DD2d5016"
                android:padding="14dp"
                android:elevation="12dp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="#8fad6f"
                android:visibility="gone" />
        </FrameLayout>

        <!-- ─── Bottom Panel (untere 50%) ─────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bottomCard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:cardBackgroundColor="#2d2d2d"
            app:cardElevation="8dp"
            app:cardCornerRadius="16dp"
            android:layout_margin="0dp"
            app:layout_constraintTop_toBottomOf="@id/mapFrame"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- ═══════════════════════════════════════ -->
                <!-- KATEGORIEN-ANSICHT                      -->
                <!-- ═══════════════════════════════════════ -->
                <LinearLayout
                    android:id="@+id/categoryView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📍 POI Kategorien wählen"
                        android:textColor="#8fad6f"
                        android:textSize="@dimen/text_body_medium"
                        android:textStyle="bold"
                        android:padding="16dp"
                        android:textAlignment="center"
                        android:background="#3d3d3d" />

                    <androidx.core.widget.NestedScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fillViewport="true">

                        <GridLayout
                            android:id="@+id/categoryGrid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:columnCount="3"
                            android:rowCount="6"
                            android:padding="12dp"
                            android:alignmentMode="alignBounds"
                            android:columnOrderPreserved="false"
                            android:useDefaultMargins="true" />

                    </androidx.core.widget.NestedScrollView>
                </LinearLayout>

                <!-- ═══════════════════════════════════════ -->
                <!-- POI-LISTE                               -->
                <!-- ═══════════════════════════════════════ -->
                <LinearLayout
                    android:id="@+id/poiListView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:background="#3d3d3d"
                        android:gravity="center_vertical">

                        <Button
                            android:id="@+id/btnBackToCategories"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="← Zurück"
                            android:textSize="@dimen/text_body_medium"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/poi_button_bg"
                            android:padding="0dp"
                            android:layout_marginEnd="8dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/categoryTitleText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🐕 Hundeauslauf"
                                android:textColor="#8FC357"
                                android:textSize="@dimen/text_body_medium"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/poiCountText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 POI in 3 km"
                                android:textColor="#999999"
                                android:textSize="@dimen/text_body_medium" />
                        </LinearLayout>
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/poiRecyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="6dp"
                            android:clipToPadding="false" />

                        <ProgressBar
                            android:id="@+id/poiProgressBar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:indeterminateTint="#8fad6f"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/emptyPoiText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="Keine POI gefunden"
                            android:textColor="#666666"
                            android:textSize="@dimen/text_body_medium"
                            android:textAlignment="center"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>

                <!-- ═══════════════════════════════════════ -->
                <!-- NAVIGATIONS-CARDS (während Navigation)  -->
                <!-- ═══════════════════════════════════════ -->
                <LinearLayout
                    android:id="@+id/navigationCardsView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:background="#2d2d2d">

                    <!-- Nav-Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="#3d3d3d"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🧭 Navigation aktiv"
                            android:textColor="#8FC357"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvNavHeaderInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#CCCCCC"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Horizontal scrollbare Cards -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:scrollbars="none"
                        android:fillViewport="false"
                        android:clipToPadding="false">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:padding="12dp"
                            android:gravity="fill_vertical">

                            <!-- ─── CARD 1: Höhenprofil ─────────── -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="270dp"
                                android:layout_height="match_parent"
                                app:cardBackgroundColor="#3a3a3a"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="4dp"
                                android:layout_marginEnd="12dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:padding="12dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="📈  Höhenprofil"
                                        android:textColor="#8FC357"
                                        android:textStyle="bold"
                                        android:textSize="13sp"
                                        android:layout_marginBottom="4dp" />

                                    <com.hundewildnis.app.ElevationChartView
                                        android:id="@+id/elevationChart"
                                        android:layout_width="match_parent"
                                        android:layout_height="0dp"
                                        android:layout_weight="1" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- ─── CARD 2: Höheninfos ──────────── -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardElevationStats"
                                android:layout_width="205dp"
                                android:layout_height="match_parent"
                                app:cardBackgroundColor="#3a3a3a"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="4dp"
                                android:layout_marginEnd="12dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:padding="12dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="⛰️  Höheninformationen"
                                        android:textColor="#8FC357"
                                        android:textStyle="bold"
                                        android:textSize="13sp"
                                        android:layout_marginBottom="14dp" />

                                    <!-- Bergauf / Bergab -->
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:layout_marginBottom="16dp">

                                        <LinearLayout
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:orientation="vertical">
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="⬆️ Bergauf"
                                                android:textColor="#999999"
                                                android:textSize="11sp" />
                                            <TextView
                                                android:id="@+id/tvAscentValue"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="—"
                                                android:textColor="#8FC357"
                                                android:textStyle="bold"
                                                android:textSize="18sp" />
                                        </LinearLayout>

                                        <LinearLayout
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:orientation="vertical">
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="⬇️ Bergab"
                                                android:textColor="#999999"
                                                android:textSize="11sp" />
                                            <TextView
                                                android:id="@+id/tvDescentValue"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="—"
                                                android:textColor="#FF8A65"
                                                android:textStyle="bold"
                                                android:textSize="18sp" />
                                        </LinearLayout>
                                    </LinearLayout>

                                    <!-- Min / Max -->
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal">

                                        <LinearLayout
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:orientation="vertical">
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="📉 Min"
                                                android:textColor="#999999"
                                                android:textSize="11sp" />
                                            <TextView
                                                android:id="@+id/tvMinElevationValue"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="—"
                                                android:textColor="#FFFFFF"
                                                android:textStyle="bold"
                                                android:textSize="15sp" />
                                        </LinearLayout>

                                        <LinearLayout
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:orientation="vertical">
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="📈 Max"
                                                android:textColor="#999999"
                                                android:textSize="11sp" />
                                            <TextView
                                                android:id="@+id/tvMaxElevationValue"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="—"
                                                android:textColor="#FFFFFF"
                                                android:textStyle="bold"
                                                android:textSize="15sp" />
                                        </LinearLayout>
                                    </LinearLayout>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- ─── CARD 3: Oberfläche & Wegtyp ─── -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="230dp"
                                android:layout_height="match_parent"
                                app:cardBackgroundColor="#3a3a3a"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="4dp">

                                <ScrollView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scrollbars="none">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical"
                                        android:padding="12dp">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="🛤️  Oberfläche"
                                            android:textColor="#8FC357"
                                            android:textStyle="bold"
                                            android:textSize="13sp"
                                            android:layout_marginBottom="8dp" />

                                        <!-- Oberflächen-Einträge (dynamisch befüllt) -->
                                        <LinearLayout
                                            android:id="@+id/surfaceInfoContainer"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:orientation="vertical"
                                            android:layout_marginBottom="10dp" />

                                        <View
                                            android:layout_width="match_parent"
                                            android:layout_height="1dp"
                                            android:background="#484848"
                                            android:layout_marginBottom="10dp" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="🛣️  Wegtyp"
                                            android:textColor="#8FC357"
                                            android:textStyle="bold"
                                            android:textSize="13sp"
                                            android:layout_marginBottom="8dp" />

                                        <!-- Wegtyp-Einträge (dynamisch befüllt) -->
                                        <LinearLayout
                                            android:id="@+id/wayTypeInfoContainer"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:orientation="vertical" />

                                    </LinearLayout>
                                </ScrollView>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- ─── CARD 4: Wetter am Ziel ──────────── -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="220dp"
                                android:layout_height="match_parent"
                                app:cardBackgroundColor="#3a3a3a"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="4dp"
                                android:layout_marginStart="12dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:padding="12dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="⛅  Wetter am Ziel"
                                        android:textColor="#8FC357"
                                        android:textStyle="bold"
                                        android:textSize="13sp"
                                        android:layout_marginBottom="8dp" />

                                    <!-- Icon + Beschreibung -->
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:gravity="center_vertical"
                                        android:layout_marginBottom="10dp">

                                        <TextView
                                            android:id="@+id/tvWeatherIcon"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="…"
                                            android:textSize="28sp"
                                            android:layout_marginEnd="8dp" />

                                        <LinearLayout
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:orientation="vertical">

                                            <TextView
                                                android:id="@+id/tvWeatherDesc"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="Laden…"
                                                android:textColor="#CCCCCC"
                                                android:textSize="11sp" />

                                            <TextView
                                                android:id="@+id/tvWeatherArrivalLabel"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text=""
                                                android:textColor="#777777"
                                                android:textSize="10sp" />
                                        </LinearLayout>
                                    </LinearLayout>

                                    <!-- Temperatur -->
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:layout_marginBottom="8dp">

                                        <LinearLayout
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:orientation="vertical">
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="🌡️ Temp"
                                                android:textColor="#999999"
                                                android:textSize="10sp" />
                                            <TextView
                                                android:id="@+id/tvWeatherTemp"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="—"
                                                android:textColor="#FFFFFF"
                                                android:textStyle="bold"
                                                android:textSize="16sp" />
                                        </LinearLayout>

                                        <LinearLayout
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:orientation="vertical">
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="🌧️ Regen"
                                                android:textColor="#999999"
                                                android:textSize="10sp" />
                                            <TextView
                                                android:id="@+id/tvWeatherPrecip"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="—"
                                                android:textColor="#64B5F6"
                                                android:textStyle="bold"
                                                android:textSize="16sp" />
                                        </LinearLayout>
                                    </LinearLayout>

                                    <!-- Wind + Luftfeuchte -->
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:layout_marginBottom="10dp">

                                        <LinearLayout
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:orientation="vertical">
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="💨 Wind"
                                                android:textColor="#999999"
                                                android:textSize="10sp" />
                                            <TextView
                                                android:id="@+id/tvWeatherWind"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="—"
                                                android:textColor="#FFFFFF"
                                                android:textSize="12sp" />
                                        </LinearLayout>

                                        <LinearLayout
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:orientation="vertical">
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="💧 Feuchte"
                                                android:textColor="#999999"
                                                android:textSize="10sp" />
                                            <TextView
                                                android:id="@+id/tvWeatherHumidity"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="—"
                                                android:textColor="#FFFFFF"
                                                android:textSize="12sp" />
                                        </LinearLayout>
                                    </LinearLayout>

                                    <!-- Trennlinie -->
                                    <View
                                        android:layout_width="match_parent"
                                        android:layout_height="1dp"
                                        android:background="#484848"
                                        android:layout_marginBottom="8dp" />

                                    <!-- Sonnenauf- / untergang -->
                                    <TextView
                                        android:id="@+id/tvWeatherSunrise"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="🌅 —"
                                        android:textColor="#CCCCCC"
                                        android:textSize="11sp"
                                        android:layout_marginBottom="4dp" />

                                    <TextView
                                        android:id="@+id/tvWeatherSunset"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="🌇 —"
                                        android:textColor="#CCCCCC"
                                        android:textSize="11sp" />

                                    <View
                                        android:layout_width="match_parent"
                                        android:layout_height="1dp"
                                        android:background="#484848"
                                        android:layout_marginTop="8dp"
                                        android:layout_marginBottom="8dp" />

                                    <TextView
                                        android:id="@+id/tvWeatherSafetyInfo"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text=""
                                        android:textSize="10.5sp"
                                        android:textStyle="bold"
                                        android:lineSpacingExtra="2dp" />

                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- ─── CARD 5: POIs entlang der Route ── -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="230dp"
                                android:layout_height="match_parent"
                                app:cardBackgroundColor="#3a3a3a"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="4dp"
                                android:layout_marginStart="12dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:padding="12dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="🗺️  Route-POIs"
                                        android:textColor="#8FC357"
                                        android:textStyle="bold"
                                        android:textSize="13sp"
                                        android:layout_marginBottom="8dp" />

                                    <TextView
                                        android:id="@+id/tvRoutePOIsStatus"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Wird geladen…"
                                        android:textColor="#777777"
                                        android:textSize="11sp"
                                        android:visibility="visible" />

                                    <ScrollView
                                        android:layout_width="match_parent"
                                        android:layout_height="0dp"
                                        android:layout_weight="1"
                                        android:scrollbars="none">

                                        <LinearLayout
                                            android:id="@+id/routePOIsContainer"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:orientation="vertical" />

                                    </ScrollView>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>
                <!-- ═ Ende navigationCardsView ═══════════════ -->

            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
