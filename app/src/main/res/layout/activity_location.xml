<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    android:background="#1a1a1a">

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- TOOLBAR                                            -->
    <!-- ═══════════════════════════════════════════════════ -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="false">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:titleTextColor="?attr/colorOnPrimary"
            app:navigationIcon="?attr/homeAsUpIndicator" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- SUCHFELD                                           -->
    <!-- ═══════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutPOISearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="?android:attr/windowBackground"
        android:elevation="4dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <EditText
            android:id="@+id/etPOISearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="🔍 Suche"
            android:textSize="@dimen/text_body_medium"
            android:paddingStart="12dp"
            android:paddingEnd="10dp"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:textColor="@color/search_field_text"
            android:textColorHint="@color/search_field_hint"
            android:background="@drawable/bg_search_field"
            android:drawableTint="@color/search_field_text"
            android:maxLines="1"/>

        <!-- NEU: Separater Clear-Button mit großer Trefferzone -->
        <ImageButton
            android:id="@+id/btnClearSearch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Suche löschen"
            android:visibility="gone"
            android:padding="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSearchPOI"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="🔍"
            android:textSize="@dimen/text_body_medium"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="24dp" />

        <ProgressBar
            android:id="@+id/progressSearch"
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- HAUPTINHALT: KARTE + BOTTOM-PANEL                  -->
    <!-- ═══════════════════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="72dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- ─── Karte (obere 50%) ──────────────────────── -->
        <FrameLayout
            android:id="@+id/mapFrame"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent="0.5"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <org.osmdroid.views.MapView
                android:id="@+id/mapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Copyright -->
            <TextView
                android:id="@+id/osmCopyrightText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="4dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="#CC000000"
                android:text="© OpenStreetMap contributors"
                android:textColor="#FFFFFF"
                android:textSize="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground" />

            <!-- Karten-Buttons (rechts oben) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:orientation="vertical"
                android:background="@drawable/button_bg_rounded"
                android:padding="4dp"
                android:elevation="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCurrentLocation"
                    style="@style/Widget.App.Button.Fixed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 Standort"
                    android:textSize="@dimen/text_body_small"
                    android:padding="8dp"
                    android:backgroundTint="?attr/colorSurface"
                    app:strokeColor="?attr/colorSecondary"
                    app:strokeWidth="2dp"
                    app:cornerRadius="8dp"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginEnd="8dp"
                    android:minWidth="100dp"
                    android:minHeight="0dp"
                    app:autoSizeTextType="none" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/shareButton"
                    style="@style/Widget.App.Button.Fixed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📤 Teilen"
                    android:textSize="@dimen/text_body_small"
                    android:padding="8dp"
                    android:backgroundTint="?attr/colorSurface"
                    app:strokeColor="?attr/colorSecondary"
                    app:strokeWidth="2dp"
                    app:cornerRadius="8dp"
                    android:textColor="?attr/colorOnSurface"
                    android:enabled="false"
                    android:minWidth="100dp"
                    android:minHeight="0dp"
                    app:autoSizeTextType="none" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleMapRotation"
                    style="@style/Widget.App.Button.Fixed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/map_orientation_north"
                    android:textSize="@dimen/text_body_small"
                    android:padding="8dp"
                    android:backgroundTint="?attr/colorSurface"
                    app:strokeColor="?attr/colorSecondary"
                    app:strokeWidth="2dp"
                    app:cornerRadius="8dp"
                    android:textColor="?attr/colorOnSurface"
                    android:minWidth="100dp"
                    android:minHeight="0dp"
                    app:autoSizeTextType="none" />
            </LinearLayout>

            <!-- Koordinaten -->
            <TextView
                android:id="@+id/coordinatesText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="16dp"
                android:text="📍 Standort wird ermittelt..."
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_body_small"
                android:background="#80000000"
                android:padding="6dp"
                android:elevation="4dp" />

            <!-- Navigation Distanz/Zeit Info -->
            <TextView
                android:id="@+id/navigationInfoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="90dp"
                android:text="🧭 0.0 km • 0 Min"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_body_medium"
                android:textStyle="bold"
                android:background="@color/rd_label_overlay_strong"
                android:padding="14dp"
                android:elevation="12dp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/rd_overlay_accent"
                android:visibility="gone" />
        </FrameLayout>

        <!-- ─── Bottom Panel (untere 50%) ─────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bottomCard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardElevation="8dp"
            app:cardCornerRadius="16dp"
            android:layout_margin="0dp"
            app:layout_constraintTop_toBottomOf="@id/mapFrame"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- ═══════════════════════════════════════ -->
                <!-- KATEGORIEN-ANSICHT                      -->
                <!-- ═══════════════════════════════════════ -->
                <LinearLayout
                    android:id="@+id/categoryView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📍 POI Kategorien wählen"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/text_body_medium"
                        android:textStyle="bold"
                        android:padding="16dp"
                        android:textAlignment="center"
                        android:background="?attr/colorSurface" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/gridPOICategories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:spanCount="3" />
                </LinearLayout>

                <!-- ═══════════════════════════════════════ -->
                <!-- POI-LISTE                               -->
                <!-- ═══════════════════════════════════════ -->
                <LinearLayout
                    android:id="@+id/poiListView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/poiListHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:background="@color/rd_surface_alt"
                        android:gravity="center_vertical">

                        <Button
                            android:id="@+id/btnBackToCategories"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="← Zurück"
                            android:textSize="@dimen/text_body_medium"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/poi_button_bg"
                            android:padding="0dp"
                            android:layout_marginEnd="8dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/categoryTitleText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🐕 Hundeauslauf"
                                android:textColor="@color/rd_overlay_accent"
                                android:textSize="@dimen/text_body_medium"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/poiCountText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 POI in 3 km"
                                android:textColor="#999999"
                                android:textSize="@dimen/text_body_medium" />
                        </LinearLayout>

                        <!-- ✅ NEU: Verwalten-Button (nur bei Favoriten sichtbar) -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnManageFavorites"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✏️"
                            android:textSize="16sp"
                            android:padding="8dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            app:backgroundTint="#7A5C00"
                            app:cornerRadius="8dp"
                            android:textColor="#FFFFFF"
                            android:visibility="gone" />

                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/poiRecyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="6dp"
                            android:clipToPadding="false" />

                        <ProgressBar
                            android:id="@+id/poiProgressBar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:indeterminateTint="@color/rd_overlay_accent"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/emptyPoiText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="Keine POI gefunden"
                            android:textColor="#666666"
                            android:textSize="@dimen/text_body_medium"
                            android:textAlignment="center"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- NAVIGATION BOTTOM SHEET                            -->
    <!-- ═══════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/navigationCardsView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="?attr/colorSurface"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_peekHeight="72dp"
        app:behavior_hideable="true"
        app:behavior_skipCollapsed="false">

        <!-- Drag-Handle -->
        <LinearLayout
            android:id="@+id/navSheetHandle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:orientation="vertical"
            android:background="@color/rd_surface_alt"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <!-- Drag-Balken -->
            <View
                android:layout_width="64dp"
                android:layout_height="6dp"
                android:background="#999999"
                android:layout_marginBottom="8dp" />

            <!-- Interaktions-Hinweis -->
            <TextView
                android:id="@+id/tvNavExpandHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▲  Details anzeigen"
                android:textColor="@color/rd_overlay_accent"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Header-Zeile -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/rd_surface_alt"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🧭 Navigation aktiv"
                android:textColor="@color/rd_overlay_accent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- NEU: Profil-Auswahl (Fuß / Fahrrad) -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleRoutingProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:checkedButton="@+id/btnProfileFoot"
                android:layout_marginEnd="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnProfileFoot"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="48dp"
                    android:layout_height="36dp"
                    android:padding="0dp"
                    android:text="🥾"
                    app:cornerRadius="4dp"
                    app:strokeColor="@color/rd_overlay_accent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnProfileBike"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="48dp"
                    android:layout_height="36dp"
                    android:padding="0dp"
                    android:text="🚲"
                    app:cornerRadius="4dp"
                    app:strokeColor="@color/rd_overlay_accent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnProfileCar"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="48dp"
                    android:layout_height="36dp"
                    android:padding="0dp"
                    android:text="🚗"
                    app:cornerRadius="4dp"
                    app:strokeColor="@color/rd_overlay_accent" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/tvNavHeaderInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#CCCCCC"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Vertikale Cards -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- ─── CARD 1: Höhenprofil ─────────── -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    app:cardBackgroundColor="#3a3a3a"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📈  Höhenprofil"
                            android:textColor="@color/rd_overlay_accent"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:layout_marginBottom="4dp" />

                        <com.hundewildnis.app.ElevationChartView
                            android:id="@+id/elevationChart"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ─── CARD 2: Höheninfos ──────────── -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardElevationStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#3a3a3a"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⛰️  Höheninformationen"
                            android:textColor="@color/rd_overlay_accent"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:layout_marginBottom="12dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp">

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⬆️ Bergauf" android:textColor="#999999" android:textSize="11sp" />
                                <TextView android:id="@+id/tvAscentValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/rd_overlay_accent" android:textStyle="bold" android:textSize="18sp" />
                            </LinearLayout>

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⬇️ Bergab" android:textColor="#999999" android:textSize="11sp" />
                                <TextView android:id="@+id/tvDescentValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FF8A65" android:textStyle="bold" android:textSize="18sp" />
                            </LinearLayout>

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📉 Min" android:textColor="#999999" android:textSize="11sp" />
                                <TextView android:id="@+id/tvMinElevationValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp" />
                            </LinearLayout>

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📈 Max" android:textColor="#999999" android:textSize="11sp" />
                                <TextView android:id="@+id/tvMaxElevationValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ─── CARD 3: Oberfläche & Wegtyp ─── -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#3a3a3a"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🛤️  Oberfläche"
                            android:textColor="@color/rd_overlay_accent"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:id="@+id/surfaceInfoContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="10dp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#484848"
                            android:layout_marginBottom="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🛣️  Wegtyp"
                            android:textColor="@color/rd_overlay_accent"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:id="@+id/wayTypeInfoContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ─── CARD: Geländeanalyse ──────────── -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTerrainAnalysis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#3a3a3a"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <!-- Titel-Zeile + Steigungsklasse-Badge -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="🧭  Geländeanalyse"
                                android:textColor="@color/rd_overlay_accent"
                                android:textStyle="bold"
                                android:textSize="13sp" />

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardSlopeClassBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:cardCornerRadius="20dp"
                                app:cardElevation="0dp">
                                <TextView
                                    android:id="@+id/tvSlopeClassBadge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:paddingHorizontal="12dp"
                                    android:paddingVertical="5dp"
                                    android:text="🟢 Flach"
                                    android:textColor="#FFFFFF"
                                    android:textStyle="bold"
                                    android:textSize="11sp" />
                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>

                        <!-- Hundeauswahl (nur sichtbar bei mehreren Hunden) -->
                        <LinearLayout
                            android:id="@+id/rowDogSelector"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🐕 Für:"
                                android:textColor="#AAAAAA"
                                android:textSize="11sp"
                                android:layout_marginEnd="8dp" />

                            <Spinner
                                android:id="@+id/spinnerTerrainDog"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/spinner_background" />

                        </LinearLayout>

                        <!-- Empfohlene Maximaldistanz -->
                        <LinearLayout
                            android:id="@+id/rowRecommendedDistance"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="?attr/colorSurface"
                            android:padding="10dp"
                            android:layout_marginBottom="10dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Empfohlene Maximaldistanz zum Ziel (bei Annahme des ähnlichen Rückwegs) für diesen Hund"
                                android:textColor="#AAAAAA"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvRecommendedDistance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textColor="@color/rd_overlay_accent"
                                android:textStyle="bold"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <!-- Distanzvergleich-Hinweis (z.B. "Route ist 30% länger als empfohlen") -->
                        <TextView
                            android:id="@+id/tvDistanceComparison"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:textColor="#999999"
                            android:layout_marginBottom="10dp"
                            android:visibility="gone" />

                        <!-- Warnungs-Container (dynamisch befüllt) -->
                        <LinearLayout
                            android:id="@+id/terrainWarningsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <!-- Hinweis wenn keine Warnungen -->
                        <TextView
                            android:id="@+id/tvNoWarnings"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="✅ Keine besonderen Risiken für diese Strecke erkannt."
                            android:textColor="@color/rd_overlay_accent"
                            android:textSize="12sp"
                            android:visibility="gone" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>


                <!-- ─── CARD 4: Wetter am Ziel ──────── -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#3a3a3a"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⛅  Wetter am Ziel"
                            android:textColor="@color/rd_overlay_accent"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <TextView android:id="@+id/tvWeatherIcon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="…" android:textSize="28sp" android:layout_marginEnd="12dp" />

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:id="@+id/tvWeatherDesc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Laden…" android:textColor="#CCCCCC" android:textSize="13sp" />
                                <TextView android:id="@+id/tvWeatherArrivalLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#777777" android:textSize="11sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌡️ Temp" android:textColor="#999999" android:textSize="10sp" />
                                <TextView android:id="@+id/tvWeatherTemp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp" />
                            </LinearLayout>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌧️ Regen" android:textColor="#999999" android:textSize="10sp" />
                                <TextView android:id="@+id/tvWeatherPrecip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#64B5F6" android:textStyle="bold" android:textSize="16sp" />
                            </LinearLayout>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💨 Wind" android:textColor="#999999" android:textSize="10sp" />
                                <TextView android:id="@+id/tvWeatherWind" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="12sp" />
                            </LinearLayout>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💧 Feuchte" android:textColor="#999999" android:textSize="10sp" />
                                <TextView android:id="@+id/tvWeatherHumidity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#484848" android:layout_marginBottom="8dp" />

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
                            <TextView android:id="@+id/tvWeatherSunrise" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🌅 —" android:textColor="#CCCCCC" android:textSize="11sp" />
                            <TextView android:id="@+id/tvWeatherSunset" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🌇 —" android:textColor="#CCCCCC" android:textSize="11sp" />
                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#484848" android:layout_marginBottom="6dp" />

                        <TextView
                            android:id="@+id/tvWeatherSafetyInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            android:lineSpacingExtra="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ─── CARD 5: Route-POIs ───────────── -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#3a3a3a"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🗺️  Route-POIs"
                            android:textColor="@color/rd_overlay_accent"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tvRoutePOIsStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wird geladen…"
                            android:textColor="#777777"
                            android:textSize="11sp"
                            android:visibility="visible" />

                        <LinearLayout
                            android:id="@+id/routePOIsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>