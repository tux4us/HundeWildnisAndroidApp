<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/net_services_intro"
            android:textSize="@dimen/text_body_medium"
            android:paddingBottom="16dp"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- Wetter -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/net_services_weather_title"
            android:textSize="@dimen/text_body_medium"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/net_services_weather_desc"
            android:textSize="@dimen/text_body_medium"
            android:paddingBottom="8dp"
            android:textColor="?android:attr/textColorSecondary" />

        <RadioGroup
            android:id="@+id/radioWeatherProvider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radioProviderNone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/net_services_provider_none"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioProviderOwm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/net_services_provider_owm"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioProviderOpenMeteo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/net_services_provider_open_meteo"
                android:textSize="14sp" />
        </RadioGroup>

        <!-- OpenWeatherMap -->
        <LinearLayout
            android:id="@+id/groupOwm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/net_services_owm_desc"
                android:textSize="@dimen/text_body_medium"
                android:textColor="?android:attr/textColorSecondary" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/net_services_owm_key_hint"
                app:boxStrokeColor="@color/text_input_stroke_color"
                app:hintTextColor="@color/text_input_hint_color"
                style="@style/Widget.App.TextInputLayout">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editOwmApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Open-Meteo -->
        <LinearLayout
            android:id="@+id/groupOpenMeteo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/net_services_open_meteo_desc"
                android:textSize="@dimen/text_body_medium"
                android:textColor="?android:attr/textColorSecondary" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/net_services_weather_url_hint"
                app:boxStrokeColor="@color/text_input_stroke_color"
                app:hintTextColor="@color/text_input_hint_color"
                style="@style/Widget.App.TextInputLayout">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editWeatherUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/net_services_air_url_hint"
                app:boxStrokeColor="@color/text_input_stroke_color"
                app:hintTextColor="@color/text_input_hint_color"
                style="@style/Widget.App.TextInputLayout">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editAirQualityUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/net_services_weather_key_hint"
                app:boxStrokeColor="@color/text_input_stroke_color"
                app:hintTextColor="@color/text_input_hint_color"
                style="@style/Widget.App.TextInputLayout">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editWeatherApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/dividerVertical"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp" />

        <!-- Overpass -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/net_services_overpass_title"
            android:textSize="@dimen/text_body_medium"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/net_services_overpass_desc"
            android:textSize="@dimen/text_body_medium"
            android:paddingBottom="12dp"
            android:textColor="?android:attr/textColorSecondary" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/net_services_overpass_url_hint"
            app:boxStrokeColor="@color/text_input_stroke_color"
            app:hintTextColor="@color/text_input_hint_color"
            style="@style/Widget.App.TextInputLayout">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editOverpassUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.hundewildnis.app.GlassButton
            android:id="@+id/btnResetNetworkServices"
            style="@style/Widget.App.Button.Outlined.Warning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="12dp"
            android:text="@string/net_services_reset"
            android:textSize="12sp"
            android:padding="0dp" />
    </LinearLayout>
</ScrollView>
