<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fokussiert/aktiv: deutlich sichtbarer Ocker-Akzent (modus-automatisch über rd_overlay_accent) -->
    <item android:state_focused="true" android:color="@color/rd_overlay_accent" />
    <!-- Fehler-Zustand: rot -->
    <item android:state_enabled="false" android:color="@color/rd_border_light" android:alpha="0.5" />
    <!-- Ruhezustand: gedeckter Rahmen -->
    <item android:color="@color/rd_border_light" />
</selector>
