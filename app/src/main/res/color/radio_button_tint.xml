<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Aktiv / Checked: Akzentfarbe des jeweiligen Modus -->
    <item android:state_checked="true" android:color="@color/rd_overlay_accent" />

    <!-- Nicht aktiv: Grauton für bessere Sichtbarkeit auf weißem/dunklem Grund -->
    <item android:state_checked="false" android:color="#888888" />

    <!-- Default -->
    <item android:color="#888888" />
</selector>
