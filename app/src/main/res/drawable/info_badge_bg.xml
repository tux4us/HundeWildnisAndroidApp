<?xml version="1.0" encoding="utf-8"?>
<!-- Info-Badge Hintergrund (Gelb/Orange) - für mittlere Warnungen -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#002A2C" />

    <corners android:radius="20dp" />

    <stroke
        android:width="2dp"
        android:color="#1A237E" />

    <padding
        android:left="12dp"
        android:right="12dp"
        android:top="6dp"
        android:bottom="6dp" />

</shape>