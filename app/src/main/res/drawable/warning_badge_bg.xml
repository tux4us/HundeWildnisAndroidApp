<?xml version="1.0" encoding="utf-8"?>
<!-- Warnung-Badge (Glas, Orange) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
    <shape
            android:shape="rectangle">
            <solid android:color="@color/gl_fill" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/gl_warning_stroke" />
            <padding
                android:left="12dp"
                android:right="12dp"
                android:top="6dp"
                android:bottom="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="270"
                android:startColor="#1FFFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#1F000000"
                android:centerY="0.45" />
        </shape>
    </item>
</layer-list>
