<?xml version="1.0" encoding="utf-8"?>
<!-- Good-Badge Hintergrund (Grün) - für gutes Wetter -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#8fad6f" />

    <corners android:radius="20dp" />

    <stroke
        android:width="2dp"
        android:color="#2d5016" />

    <padding
        android:left="12dp"
        android:right="12dp"
        android:top="6dp"
        android:bottom="6dp" />

</shape>