<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet & Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Location (GPS) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- ACCESS_BACKGROUND_LOCATION entfernt, da Foreground Service genutzt wird -->

    <!-- Foreground Service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Vibration -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Storage (für PDF-Export) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- ✅ CAMERA & MEDIA (für Hunde-Stammdaten) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- ✅ MIKROFON Permission -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Direkt nach den bestehenden uses-permission-Zeilen: -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />


    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher_hundewildnis"
        android:label="@string/app_name"
        android:theme="@style/Theme.HundeWildnis"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- ════════════════════════════════════════════════ -->
        <!-- LAUNCHER: StartActivity -->
        <!-- ════════════════════════════════════════════════ -->
        <activity
            android:name="com.hundewildnis.app.StartActivity"
            android:exported="true"
            android:theme="@style/Theme.HundeWildnis">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.hundewildnis.app.BackupActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName="com.hundewildnis.app.StartActivity"
            android:theme="@style/Theme.HundeWildnis" />

        <activity
            android:name="com.hundewildnis.app.DogProfileActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName="com.hundewildnis.app.StartActivity"
            android:theme="@style/Theme.HundeWildnis" />

        <activity
            android:name="com.hundewildnis.app.DogEditActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName="com.hundewildnis.app.DogProfileActivity"
            android:theme="@style/Theme.HundeWildnis" />

        <activity
            android:name="com.hundewildnis.app.DogViewActivity"
            android:exported="false"
            android:parentActivityName="com.hundewildnis.app.DogProfileActivity"
            android:theme="@style/Theme.HundeWildnis" />

        <activity
            android:name="com.hundewildnis.app.QRCodeActivity"
            android:exported="false"
            android:parentActivityName="com.hundewildnis.app.DogProfileActivity"
            android:theme="@style/Theme.HundeWildnis" />

        <activity
            android:name="com.hundewildnis.app.EmergencyActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName="com.hundewildnis.app.DogProfileActivity"
            android:theme="@style/Theme.HundeWildnis" />

        <activity
            android:name="com.hundewildnis.app.WalkingSpeedActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HundeWildnis"
            android:parentActivityName="com.hundewildnis.app.StartActivity" />

        <activity
            android:name="com.hundewildnis.app.DailyNotesActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HundeWildnis"
            android:parentActivityName="com.hundewildnis.app.StartActivity" />

        <activity
            android:name="com.hundewildnis.app.SupportActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName="com.hundewildnis.app.StartActivity"
            android:theme="@style/Theme.HundeWildnis" />

        <activity
            android:name="com.hundewildnis.app.CompassActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="fullSensor"
            android:exported="false"
            android:parentActivityName="com.hundewildnis.app.StartActivity" />

        <activity
            android:name="com.hundewildnis.app.WeatherActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="fullSensor"
            android:exported="false"
            android:parentActivityName="com.hundewildnis.app.StartActivity" />

        <activity
            android:name="com.hundewildnis.app.LocationActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="fullSensor"
            android:exported="false"
            android:parentActivityName="com.hundewildnis.app.StartActivity" />

        <activity
            android:name="com.hundewildnis.app.AltimeterActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="fullSensor"
            android:exported="false"
            android:parentActivityName="com.hundewildnis.app.StartActivity" />

        <activity
            android:name="com.hundewildnis.app.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.HundeWildnis" />

        <activity
            android:name="com.hundewildnis.app.ImprintActivity"
            android:label="Impressum"
            android:parentActivityName="com.hundewildnis.app.MainActivity"
            android:exported="false" />

        <activity
            android:name="com.hundewildnis.app.ContentActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:parentActivityName="com.hundewildnis.app.MainActivity" />

        <service
            android:name="com.hundewildnis.app.WalkingSpeedService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <activity
            android:name="com.hundewildnis.app.CommunicationActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName="com.hundewildnis.app.StartActivity"
            android:theme="@style/Theme.HundeWildnis" />

        <service
            android:name="com.hundewildnis.app.NavigationForegroundService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- ════════════════════════════════════════════════ -->
        <!-- ✅ TRAININGSTAGEBUCH (NEU!) -->
        <!-- ════════════════════════════════════════════════ -->
        <activity
            android:name="com.hundewildnis.app.TrainingDiaryActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName="com.hundewildnis.app.StartActivity"
            android:theme="@style/Theme.HundeWildnis" />

        <activity
            android:name="com.hundewildnis.app.CategoryListActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName="com.hundewildnis.app.TrainingDiaryActivity"
            android:theme="@style/Theme.HundeWildnis" />

        <activity
            android:name="com.hundewildnis.app.TrainingDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName="com.hundewildnis.app.CategoryListActivity"
            android:theme="@style/Theme.HundeWildnis" />

        <activity
            android:name="com.hundewildnis.app.AddSessionActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName="com.hundewildnis.app.TrainingDetailActivity"
            android:theme="@style/Theme.HundeWildnis" />

        <!-- ════════════════════════════════════════════════ -->
        <!-- ✅ ERSTE HILFE WIZZARD (NEU!) -->
        <!-- ════════════════════════════════════════════════ -->

        <!-- Erste-Hilfe Wizard -->
        <activity
            android:name=".FirstAidWizardActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <!-- Erste-Hilfe Anleitung -->
        <activity
            android:name=".FirstAidInstructionActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <!-- HLW Timer -->
        <activity
            android:name=".HLWTimerActivity"
            android:screenOrientation="portrait"
            android:exported="false"/>

        <!-- Einfacher Timer (optional für Hitzschlag etc.) -->
        <activity
            android:name=".SimpleTimerActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".HeatCycleActivity"
            android:label="Läufigkeit"
            android:parentActivityName=".DogViewActivity" />


        <!-- ════════════════════════════════════════════════ -->
        <!-- ✅ NASENARBEIT                                  -->
        <!-- ════════════════════════════════════════════════ -->

        <activity
            android:name="com.hundewildnis.app.NasenarbeitActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName="com.hundewildnis.app.StartActivity"
            android:theme="@style/Theme.HundeWildnis" />

        <activity
            android:name="com.hundewildnis.app.NasenarbeitHundActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName="com.hundewildnis.app.NasenarbeitActivity"
            android:theme="@style/Theme.HundeWildnis" />

        <activity
            android:name="com.hundewildnis.app.NasenarbeitBeratungActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName="com.hundewildnis.app.NasenarbeitHundActivity"
            android:theme="@style/Theme.HundeWildnis" />

        <activity
            android:name="com.hundewildnis.app.NasenarbeitErgebnisActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName="com.hundewildnis.app.NasenarbeitBeratungActivity"
            android:theme="@style/Theme.HundeWildnis" />

        <activity
            android:name="com.hundewildnis.app.NasenarbeitSessionDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName="com.hundewildnis.app.NasenarbeitHundActivity"
            android:theme="@style/Theme.HundeWildnis" />

        <!-- WorkManager Worker braucht KEINE separate Manifest-Eintragung -->

        <!-- ✅ NEU: Nasenarbeit Kartenauswahl (Phase 1 OSM) -->
        <activity
            android:name="com.hundewildnis.app.NasenarbeitMapActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HundeWildnis"
            android:parentActivityName="com.hundewildnis.app.NasenarbeitBeratungActivity"/>

    </application>
</manifest>