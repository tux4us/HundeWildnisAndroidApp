# Beispiel: in "local.properties" umbenennen. Diese Datei gehört NICHT in die Versionsverwaltung.
#
# Pfad zum Android-SDK (nur nötig, wenn ANDROID_HOME nicht gesetzt ist):
# sdk.dir=/pfad/zum/Android/Sdk

# Optional: Voreinstellung für den OpenRouteService-Schlüssel in selbst gebauten Versionen.
# Nutzerinnen und Nutzer tragen ihren eigenen Schlüssel in der App unter Einstellungen ein.
# Ohne Eintrag enthält der Build keinen Schlüssel (so wird auch F-Droid bauen).
ORS_API_KEY=
